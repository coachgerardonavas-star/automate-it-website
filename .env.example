# Variables del Client Portal (/portal).
#
# Copiar a `.env` para desarrollo local. En producción NO van en un archivo:
# se cargan como variables del proyecto de Cloudflare Pages, y el portal las
# lee desde `locals.runtime.env`.
#
# Ninguna de las dos es secreta en el sentido estricto — la anon key está
# pensada para viajar al navegador — pero acá ni siquiera hace falta que salga
# del servidor: todas las consultas se hacen desde el render en Cloudflare.
#
# Lo que SÍ es secreto y NO debe aparecer nunca en este proyecto:
#   SUPABASE_SERVICE_ROLE_KEY — salta RLS por completo. Si algún día hace falta
#   para la ingesta de telemetría, vive en un Worker aparte, jamás acá.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
