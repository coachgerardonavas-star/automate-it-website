{
  "name": "automate-it-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/ensure-workers-target.mjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && astro build && node scripts/check-worker-chunks.mjs",
    "deploy:built": "wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/markdoc": "2.0.9",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/open-sans": "^5.2.7",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "18.3.1",
    "astro": "7.3.5",
    "lucide-astro": "^0.556.0",
    "react": "19.3.0",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "postcss": "8.5.24",
    "puppeteer": "25.12.0",
    "sharp": "0.35.4",
    "wawoff2": "^2.0.1",
    "wrangler": "4.141.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
