# Baseline security headers — Glasswing
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN

# Assets con hash de contenido que genera Astro (/_astro/*.css, *.js).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes: nombre estable pero cambian muy rara vez.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes y otros estáticos en /assets (nombre NO versionado).
/assets/*
  Cache-Control: public, max-age=2592000

# Guías públicas (lead magnets).
/guias/*
  Cache-Control: public, max-age=86400

# Documentos de cliente. noindex no equivale a autenticación.
/d/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, max-age=0, must-revalidate

# Portal de clientes: nunca almacenar respuestas personalizadas en caché compartida.
/portal/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0, must-revalidate
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
