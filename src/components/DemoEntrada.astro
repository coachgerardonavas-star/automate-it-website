---
/**
 * Entrada de /demo — lo que abre la tarjeta NFC.
 *
 * Una sola pantalla: "Míralo tú mismo" y dos campos, el nombre de la persona y
 * el de su negocio. El formulario va por POST a `/demo/entrar`, que abre el
 * portal con datos de ejemplo saludándola por su nombre y hablando de su
 * negocio. POST para que el nombre no quede en la URL.
 *
 * Funciona sin JavaScript: el script de abajo solo manda el evento de GA.
 * Fondo oscuro de marca con acento cyan; el lima queda fuera porque aquí nada
 * está "en vivo" (regla del manual de marca).
 */
import { translations, type Lang } from "../i18n/translations";
import { WHATSAPP_NUMBER } from "../config/site";
import { MonitorPlay, ArrowRight } from "lucide-astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].demoEntrada;
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(t.whatsappMessage)}`;
---

<div class="entry">
  <div class="entry__glow" aria-hidden="true"></div>

  <header class="entry__top">
    <p class="entry__brand-top">Automate IT</p>
    <a href={t.switchLangHref} hreflang={lang === "es" ? "en" : "es"}>{t.switchLang}</a>
  </header>

  <main class="entry__main">
    <div class="entry__card">
      <div class="entry__visual" aria-hidden="true">
        <span class="entry__icon"><MonitorPlay size={120} stroke-width={1.5} /></span>
      </div>

      <div class="entry__divider" aria-hidden="true"></div>

      <div class="entry__text">
        <p class="entry__eyebrow">{t.eyebrow}</p>
        <h1 class="entry__title">{t.title}</h1>
        <p class="entry__body">{t.body}</p>

        <form class="entry__form" method="post" action="/demo/entrar" data-entry-form>
          <input type="hidden" name="lang" value={lang} />

          <label class="entry__field">
            <span>{t.nameLabel}</span>
            <input
              type="text"
              name="name"
              required
              maxlength="40"
              autocomplete="given-name"
              autocapitalize="words"
              placeholder={t.namePlaceholder}
            />
          </label>

          <label class="entry__field">
            <span>{t.businessLabel}</span>
            <input
              type="text"
              name="business"
              required
              maxlength="60"
              autocomplete="organization"
              autocapitalize="words"
              placeholder={t.businessPlaceholder}
            />
          </label>

          <button type="submit" class="entry__cta">
            {t.openDemo}
            <ArrowRight size={20} aria-hidden="true" />
          </button>

          <p class="entry__note">{t.privacyNote}</p>
        </form>

        <a
          class="entry__talk"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          data-entry-whatsapp
        >
          {t.talk}
        </a>
      </div>
    </div>

    <p class="entry__pillars">
      {t.pillars.map((p, j) => (
        <>
          {j > 0 && <span class="entry__pillar-dot" aria-hidden="true"></span>}
          <span>{p}</span>
        </>
      ))}
    </p>
  </main>

  <p class="entry__brand">Automate IT · {t.brandLine}</p>
</div>

<style>
  .entry {
    --entry-bg: #050a18;
    --entry-cyan: #00d9ff;
    --entry-blue: #0052cc;
    --entry-muted: #a9b4c7;
    --entry-line: rgba(255, 255, 255, 0.14);
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--entry-bg);
    color: #fff;
    overflow: hidden;
  }

  /* Haces diagonales de la esquina, en el azul/cyan de marca. */
  .entry__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, transparent 62%, rgba(0, 217, 255, 0.16) 62.2%, transparent 70%),
      linear-gradient(135deg, transparent 70%, rgba(0, 82, 204, 0.35) 70.2%, transparent 84%),
      linear-gradient(135deg, transparent 84%, rgba(0, 217, 255, 0.22) 84.2%, transparent 92%),
      radial-gradient(60rem 30rem at 110% 110%, rgba(0, 82, 204, 0.25), transparent 70%);
  }

  .entry__top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1rem 0;
    font-size: 0.8125rem;
  }
  .entry__brand-top {
    font-family: "Manifold CF", Montserrat, system-ui, sans-serif;
    font-size: 1.125rem;
    letter-spacing: 0.02em;
    color: var(--entry-cyan);
  }
  .entry__top a {
    color: var(--entry-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .entry__top a:hover {
    color: #fff;
  }

  .entry__main {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem;
  }

  .entry__card {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--entry-line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }

  .entry__visual {
    display: flex;
    justify-content: center;
  }
  .entry__icon {
    display: block;
    width: 4.5rem;
    color: var(--entry-cyan);
    filter: drop-shadow(0 0 18px rgba(0, 217, 255, 0.45));
  }
  .entry__icon :global(svg) {
    width: 100%;
    height: auto;
  }
  .entry__divider {
    display: none;
  }

  .entry__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--entry-cyan);
    margin-bottom: 0.75rem;
  }
  .entry__title {
    font-family: "Manifold CF", Montserrat, system-ui, sans-serif;
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: 1.04;
    margin-bottom: 0.875rem;
  }
  .entry__body {
    color: #d7deea;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 34rem;
  }

  .entry__form {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.875rem;
    max-width: 30rem;
  }
  .entry__field {
    display: grid;
    gap: 0.375rem;
  }
  .entry__field span {
    font-size: 0.875rem;
    font-weight: 600;
    color: #e6ebf3;
  }
  .entry__field input {
    width: 100%;
    min-height: 48px;
    padding: 0 0.875rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    /* 16px evita que iOS haga zoom al tocar el campo. */
    font-size: 1rem;
    transition: border-color 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .entry__field input::placeholder {
    color: #7d8aa3;
  }
  .entry__field input:focus {
    outline: none;
    border-color: var(--entry-cyan);
    box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.25);
  }

  .entry__cta {
    margin-top: 0.375rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 8px;
    background: var(--entry-blue);
    color: #fff;
    font-weight: 600;
    font-size: 1.0625rem;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(0, 217, 255, 0.35), 0 8px 28px rgba(0, 82, 204, 0.45);
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .entry__cta:hover {
    background: #003da5;
  }
  .entry__note {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--entry-muted);
  }

  .entry__talk {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.25rem 0;
    color: var(--entry-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .entry__talk:hover {
    color: #fff;
  }

  .entry__cta:focus-visible,
  .entry__talk:focus-visible,
  .entry__top a:focus-visible {
    outline: 2px solid var(--entry-cyan);
    outline-offset: 2px;
  }

  .entry__pillars {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #d7deea;
  }
  .entry__pillar-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--entry-cyan);
  }

  .entry__brand {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 1rem max(1rem, env(safe-area-inset-bottom));
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: #6f7d95;
  }

  @media (min-width: 900px) {
    .entry__top {
      padding: 1.25rem 2rem 0;
    }
    .entry__main {
      padding: 2rem;
    }
    .entry__card {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
      padding: 3.5rem 3rem;
    }
    .entry__visual {
      flex: 0 0 34%;
    }
    .entry__icon {
      width: 7.5rem;
    }
    .entry__divider {
      display: block;
      align-self: stretch;
      width: 2px;
      background: linear-gradient(to bottom, transparent, var(--entry-cyan), transparent);
      opacity: 0.8;
    }
    .entry__text {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry__cta,
    .entry__field input {
      transition: none;
    }
  }
</style>

<script>
  // Solo analítica: el formulario funciona igual sin JavaScript. Nunca se
  // manda el nombre ni el negocio a GA, solo que la demo se abrió.
  document.querySelector("[data-entry-form]")?.addEventListener("submit", () =>
    window.trackEvent?.("demo_open_dashboard"));
  document.querySelector("[data-entry-whatsapp]")?.addEventListener("click", () =>
    window.trackEvent?.("demo_whatsapp"));
  window.trackEvent?.("demo_view");
</script>
