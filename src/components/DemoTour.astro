---
/**
 * Tour de /demo — lo que abre la tarjeta NFC.
 *
 * Cuatro pantallas a ancho completo que se pasan con el dedo. El deslizamiento
 * es CSS puro (scroll-snap): sin JavaScript el tour igual se recorre. El script
 * de abajo solo suma el contador, los botones, las flechas del teclado y los
 * eventos de GA.
 *
 * La última pantalla entra al portal con datos de ejemplo (`/demo/entrar`),
 * sin cuenta. Fondo oscuro de marca con acento cyan; el lima queda fuera
 * porque aquí nada está "en vivo" (regla del manual de marca).
 */
import { translations, type Lang } from "../i18n/translations";
import { WHATSAPP_NUMBER } from "../config/site";
import {
  MessageSquareWarning, Workflow, LayoutDashboard, MonitorPlay, ArrowRight,
  ArrowLeft, CircleCheck,
} from "lucide-astro";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].demoTour;
const total = t.slides.length;
const pad = (n: number) => String(n).padStart(2, "0");

const openHref = `/demo/entrar?lang=${lang}`;
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(t.whatsappMessage)}`;
const icons = [MessageSquareWarning, Workflow, LayoutDashboard, MonitorPlay];
---

<div class="tour" data-tour data-total={total}>
  <div class="tour__glow" aria-hidden="true"></div>

  <header class="tour__top">
    <p class="tour__counter" aria-hidden="true">
      <span data-tour-current>01</span><span class="tour__counter-sep"> / </span>{pad(total)}
    </p>
    <div class="tour__top-links">
      <a href={t.switchLangHref} hreflang={lang === "es" ? "en" : "es"}>{t.switchLang}</a>
      <a href={openHref} data-tour-skip>{t.skip}</a>
    </div>
  </header>

  <div
    class="tour__track"
    data-tour-track
    role="region"
    aria-roledescription="carousel"
    aria-label={t.regionLabel}
    tabindex="0"
  >
    {t.slides.map((slide, i) => {
      const Icon = icons[i] ?? MonitorPlay;
      const isLast = i === total - 1;
      return (
        <section
          class="tour__slide"
          data-tour-slide={i}
          aria-roledescription="slide"
          aria-label={`${pad(i + 1)} / ${pad(total)}`}
        >
          <div class="tour__card">
            <div class="tour__visual" aria-hidden={i === 2 ? undefined : "true"}>
              {i === 2 ? (
                /* Miniatura del panel. Mismas cifras que la demo del portal,
                   marcadas como ejemplo: nadie debe leerlas como promesa. */
                <div class="mock">
                  <p class="mock__tag">{t.sampleLabel}</p>
                  <div class="mock__kpis">
                    {t.mockKpis.map((k) => (
                      <div class="mock__kpi">
                        <p class="mock__value">{k.value}</p>
                        <p class="mock__label">{k.label}</p>
                      </div>
                    ))}
                  </div>
                  <div class="mock__bars" aria-hidden="true">
                    {[38, 52, 44, 63, 58, 72, 66, 84, 78, 92].map((h) => (
                      <span style={`height:${h}%`}></span>
                    ))}
                  </div>
                  <p class="mock__alert">{t.mockAttention}</p>
                </div>
              ) : (
                <span class="tour__icon">
                  <Icon size={120} stroke-width={1.5} />
                </span>
              )}
            </div>

            <div class="tour__divider" aria-hidden="true"></div>

            <div class="tour__text">
              <p class="tour__eyebrow">{slide.eyebrow}</p>
              <h2 class="tour__title">{slide.title}</h2>
              <p class="tour__body">{slide.body}</p>

              {slide.items.length > 0 && (
                <ul class="tour__items">
                  {slide.items.map((item) => (
                    <li>
                      <CircleCheck size={18} aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}

              {isLast && (
                <div class="tour__actions">
                  <a class="tour__cta" href={openHref} data-tour-open>
                    {t.openDemo}
                    <ArrowRight size={20} aria-hidden="true" />
                  </a>
                  <a
                    class="tour__talk"
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-tour-whatsapp
                  >
                    {t.talk}
                  </a>
                </div>
              )}
            </div>
          </div>

          {isLast && (
            <p class="tour__pillars">
              {t.pillars.map((p, j) => (
                <>
                  {j > 0 && <span class="tour__pillar-dot" aria-hidden="true"></span>}
                  <span>{p}</span>
                </>
              ))}
            </p>
          )}
        </section>
      );
    })}
  </div>

  <footer class="tour__nav" hidden>
    <button type="button" class="tour__btn tour__btn--ghost" data-tour-prev aria-label={t.back}>
      <ArrowLeft size={20} aria-hidden="true" />
    </button>
    <div class="tour__dots" aria-hidden="true">
      {t.slides.map((_, i) => <span data-tour-dot={i}></span>)}
    </div>
    <button type="button" class="tour__btn" data-tour-next>
      <span>{t.next}</span>
      <ArrowRight size={20} aria-hidden="true" />
    </button>
  </footer>

  <p class="tour__brand">Automate IT · {t.brandLine}</p>
</div>

<style>
  .tour {
    --tour-bg: #050a18;
    --tour-cyan: #00d9ff;
    --tour-blue: #0052cc;
    --tour-text: #ffffff;
    --tour-muted: #a9b4c7;
    --tour-line: rgba(255, 255, 255, 0.14);
    position: relative;
    /* Alto fijo a la pantalla: la navegación queda siempre a la vista y, si una
       pantalla no cabe, se desplaza por dentro. */
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--tour-bg);
    color: var(--tour-text);
    overflow: hidden;
  }

  /* Haces diagonales de la esquina, en el azul/cyan de marca. */
  .tour__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, transparent 62%, rgba(0, 217, 255, 0.16) 62.2%, transparent 70%),
      linear-gradient(135deg, transparent 70%, rgba(0, 82, 204, 0.35) 70.2%, transparent 84%),
      linear-gradient(135deg, transparent 84%, rgba(0, 217, 255, 0.22) 84.2%, transparent 92%),
      radial-gradient(60rem 30rem at 110% 110%, rgba(0, 82, 204, 0.25), transparent 70%);
  }

  .tour__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0;
    max-width: 72rem;
    width: 100%;
    margin: 0 auto;
  }
  .tour__counter {
    font-family: "Manifold CF", Montserrat, system-ui, sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: var(--tour-cyan);
    font-variant-numeric: tabular-nums;
  }
  .tour__counter-sep,
  .tour__counter {
    white-space: nowrap;
  }
  .tour__counter-sep {
    color: var(--tour-muted);
  }
  .tour__top-links {
    display: flex;
    gap: 1rem;
    font-size: 0.8125rem;
  }
  .tour__top-links a {
    color: var(--tour-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tour__top-links a:hover {
    color: var(--tour-text);
  }

  .tour__track {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .tour__track::-webkit-scrollbar {
    display: none;
  }
  .tour__track:focus-visible {
    outline: 2px solid var(--tour-cyan);
    outline-offset: -4px;
  }

  .tour__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    padding: 1rem;
    overflow-y: auto;
  }
  /* Centrado con margen automático y no con justify-content: si el contenido
     es más alto que la pantalla, así no se recorta por arriba. */
  .tour__slide > :first-child {
    margin-top: auto;
  }
  .tour__slide > :last-child {
    margin-bottom: auto;
  }

  .tour__card {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--tour-line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(2px);
  }

  .tour__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .tour__icon {
    display: block;
    width: 4rem;
    color: var(--tour-cyan);
    filter: drop-shadow(0 0 18px rgba(0, 217, 255, 0.45));
  }
  .tour__icon :global(svg) {
    width: 100%;
    height: auto;
  }
  .tour__divider {
    display: none;
  }

  .tour__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--tour-cyan);
    margin-bottom: 0.75rem;
  }
  .tour__title {
    font-family: "Manifold CF", Montserrat, system-ui, sans-serif;
    font-size: clamp(1.625rem, 6.6vw, 3.25rem);
    line-height: 1.06;
    margin-bottom: 1rem;
    text-wrap: balance;
  }
  .tour__body {
    color: #d7deea;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 36rem;
  }
  .tour__items {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .tour__items li {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: #e6ebf3;
  }
  .tour__items li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.125rem;
    color: var(--tour-cyan);
  }

  .tour__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tour__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0 1.5rem;
    border-radius: 8px;
    background: var(--tour-blue);
    color: #fff;
    font-weight: 600;
    font-size: 1.0625rem;
    box-shadow: 0 0 0 1px rgba(0, 217, 255, 0.35), 0 8px 28px rgba(0, 82, 204, 0.45);
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tour__cta:hover {
    background: #003da5;
  }
  .tour__talk {
    text-align: center;
    color: var(--tour-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 0.5rem;
  }
  .tour__talk:hover {
    color: #fff;
  }

  .tour__pillars {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #d7deea;
  }
  .tour__pillar-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--tour-cyan);
  }

  /* Miniatura del panel */
  .mock {
    position: relative;
    width: 100%;
    max-width: 22rem;
    padding: 1rem;
    border-radius: 12px;
    background: #ffffff;
    color: #050a18;
    box-shadow: 0 0 0 1px rgba(0, 217, 255, 0.3), 0 18px 48px rgba(0, 0, 0, 0.45);
  }
  .mock__tag {
    position: absolute;
    top: -0.625rem;
    right: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: #fef3dc;
    color: #6b4700;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mock__kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .mock__kpi {
    padding: 0.5rem;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
  }
  .mock__value {
    font-family: "Manifold CF", Montserrat, system-ui, sans-serif;
    font-size: 1.125rem;
    color: #0052cc;
  }
  .mock__label {
    font-size: 0.625rem;
    line-height: 1.25;
    color: #5e6c84;
  }
  .mock__bars {
    margin-top: 0.75rem;
    height: 4.5rem;
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
  }
  .mock__bars span {
    flex: 1;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(to top, #0052cc, #00d9ff);
  }
  .mock__alert {
    margin-top: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 8px;
    background: #e6eefb;
    color: #003da5;
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* Navegación inferior */
  .tour__nav {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    max-width: 72rem;
    width: 100%;
    margin: 0 auto;
  }
  .tour__nav[hidden] {
    display: none;
  }
  .tour__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 1.125rem;
    border-radius: 8px;
    border: 1px solid rgba(0, 217, 255, 0.45);
    color: #fff;
    font-weight: 600;
    background: transparent;
    cursor: pointer;
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), opacity 200ms;
  }
  .tour__btn:hover {
    background: rgba(0, 217, 255, 0.1);
  }
  .tour__btn--ghost {
    padding: 0;
    border-color: var(--tour-line);
  }
  .tour__btn[disabled] {
    opacity: 0;
    pointer-events: none;
  }
  .tour__btn:focus-visible,
  .tour__cta:focus-visible,
  .tour__talk:focus-visible,
  .tour__top-links a:focus-visible {
    outline: 2px solid var(--tour-cyan);
    outline-offset: 2px;
  }
  .tour__dots {
    display: flex;
    gap: 0.5rem;
  }
  .tour__dots span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    transition: width 200ms cubic-bezier(0.2, 0, 0, 1), background-color 200ms;
  }
  .tour__dots span[data-active="true"] {
    width: 24px;
    background: var(--tour-cyan);
  }

  .tour__brand {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1rem max(1rem, env(safe-area-inset-bottom));
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: #6f7d95;
  }

  @media (min-width: 900px) {
    .tour__top,
    .tour__nav {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .tour__slide {
      padding: 2rem;
    }
    .tour__card {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
      padding: 3.5rem 3rem;
      min-height: 26rem;
    }
    .tour__visual {
      flex: 0 0 40%;
    }
    .tour__icon {
      width: 7.5rem;
    }
    .tour__divider {
      display: block;
      align-self: stretch;
      width: 2px;
      background: linear-gradient(to bottom, transparent, var(--tour-cyan), transparent);
      opacity: 0.8;
    }
    .tour__text {
      flex: 1;
    }
    .tour__actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour__track {
      scroll-behavior: auto;
    }
    .tour__dots span,
    .tour__btn,
    .tour__cta {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Solo mejora lo que el CSS ya resuelve: el contador, los botones, las
   * flechas del teclado y los eventos de GA. Sin esto el tour se recorre igual
   * deslizando.
   */
  const root = document.querySelector<HTMLElement>("[data-tour]");
  const track = root?.querySelector<HTMLElement>("[data-tour-track]");

  if (root && track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>("[data-tour-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-tour-dot]"));
    const current = root.querySelector<HTMLElement>("[data-tour-current]");
    const prev = root.querySelector<HTMLButtonElement>("[data-tour-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-tour-next]");
    const nav = root.querySelector<HTMLElement>(".tour__nav");
    const last = slides.length - 1;
    let index = 0;

    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(last, i))];
      track.scrollTo({ left: target.offsetLeft, behavior: "smooth" });
    };

    const render = () => {
      if (current) current.textContent = String(index + 1).padStart(2, "0");
      dots.forEach((d, i) => (d.dataset.active = String(i === index)));
      if (prev) prev.disabled = index === 0;
      // En la última pantalla el botón "Siguiente" sobra: la acción es el CTA.
      if (next) next.style.visibility = index === last ? "hidden" : "visible";
      slides.forEach((s, i) => s.toggleAttribute("inert", i !== index));
    };

    track.addEventListener(
      "scroll",
      () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== index) {
          index = i;
          render();
          window.trackEvent?.(`demo_tour_slide_${index + 1}`);
        }
      },
      { passive: true },
    );

    prev?.addEventListener("click", () => go(index - 1));
    next?.addEventListener("click", () => go(index + 1));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(index + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(index - 1); }
    });

    // Si el ancho cambia (girar el teléfono), la pantalla actual se reencuadra.
    window.addEventListener("resize", () => {
      track.scrollTo({ left: slides[index].offsetLeft, behavior: "auto" });
    });

    root.querySelector("[data-tour-open]")?.addEventListener("click", () =>
      window.trackEvent?.("demo_open_dashboard", { from: "tour_end" }));
    root.querySelector("[data-tour-skip]")?.addEventListener("click", () =>
      window.trackEvent?.("demo_open_dashboard", { from: "skip" }));
    root.querySelector("[data-tour-whatsapp]")?.addEventListener("click", () =>
      window.trackEvent?.("demo_whatsapp"));

    if (nav) nav.hidden = false;
    render();
    window.trackEvent?.("demo_tour_view");
  }
</script>
