---
import { translations, type Lang } from "../i18n/translations";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang].home2026;
const root = lang === "en" ? "/en" : "";
const diagnostic = lang === "en" ? "/en/diagnostic" : "/diagnostico";
---

<header class="site-nav">
  <a class="brand" href={`${root}/`} aria-label="Automate IT">
    <img src="/assets/logo-lockup.webp" width="1084" height="246" alt="Automate IT — Your Biz. Upgraded." />
  </a>
  <nav aria-label={lang === "en" ? "Main" : "Principal"}>
    <a href="#como-funciona">{t.nav.how}</a><a href="#planes">{t.nav.plans}</a><a href="#quienes-somos">{t.nav.about}</a><a href={`${root}/blog`}>{t.nav.blog}</a>
  </nav>
  <div class="nav-actions">
    <a class="lang" href={lang === "en" ? "/" : "/en/"}>{lang === "en" ? "ES" : "EN"}</a>
    <a class="button button-small" href={diagnostic}>{t.nav.diagnostic}</a>
  </div>
  <details class="mobile-menu">
    <summary aria-label={lang === "en" ? "Open menu" : "Abrir menú"}><span></span><span></span><span></span></summary>
    <nav aria-label={lang === "en" ? "Mobile navigation" : "Navegación móvil"}>
      <a href="#como-funciona">{t.nav.how}</a><a href="#planes">{t.nav.plans}</a><a href="#quienes-somos">{t.nav.about}</a><a href={`${root}/blog`}>{t.nav.blog}</a>
    </nav>
  </details>
</header>

<main>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      {lang === "es" ? (
        <h1>Tu operación debería darte <span>más control</span>, no más trabajo.</h1>
      ) : (
        <h1>{t.hero.title}</h1>
      )}
      <p class="lead">{t.hero.body}</p>
      <div class="hero-actions">
        <a class="button" href={diagnostic}>{t.hero.primary}<span aria-hidden="true">→</span></a>
        <a class="text-link" href="#como-funciona">{t.hero.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="note">{t.hero.note}</p>
    </div>
    <div class="dashboard" aria-label={t.dashboard.label}>
      <div class="dash-head"><span>{t.dashboard.label}</span><span class="live"><i></i>{t.dashboard.live}</span></div>
      <div class="dash-title"><p>{t.dashboard.title}</p><strong>•••</strong></div>
      <div class="metric"><div><span>{t.dashboard.metric}</span><b>{t.dashboard.metricValue}</b></div><svg viewBox="0 0 180 56" aria-hidden="true"><path d="M2 49 C26 45 35 48 55 34 S91 41 111 22 S145 31 178 4" fill="none" stroke="#0052CC" stroke-width="4" stroke-linecap="round"/></svg></div>
      <div class="dash-rows">{t.dashboard.rows.map((row, i) => <div class="dash-row"><span class={`row-icon i${i}`}>{i === 0 ? "↗" : i === 1 ? "✓" : "!"}</span><span>{row.name}</span><b>{row.status}</b></div>)}</div>
    </div>
  </section>

  <div class="ticker">{t.ticker.map((item) => <span>{item}<i>✦</i></span>)}</div>

  <section class="section shell problem">
    <div class="section-intro"><p class="eyebrow">{t.problem.eyebrow}</p><h2>{t.problem.title}</h2><p>{t.problem.body}</p></div>
    <div class="case-grid">{t.problem.items.map((item) => (
      <article class="plain-card case-card">
        <span class="case-label">{t.problem.label}</span>
        <h3>{item.titulo}</h3>
        <p class="case-field"><b>{t.problem.problemaLabel}:</b> {item.problema}</p>
        <p class="case-field"><b>{t.problem.solucionLabel}:</b> {item.solucion}</p>
      </article>
    ))}</div>
    <p class="case-closing">{t.problem.closing}</p>
  </section>

  <section class="section process" id="como-funciona">
    <div class="shell"><div class="section-intro"><p class="eyebrow">{t.process.eyebrow}</p><h2>{t.process.title}</h2></div>
      <div class="steps">{t.process.steps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
    </div>
  </section>

  <section class="section shell" id="planes">
    <div class="section-intro"><p class="eyebrow">{t.plans.eyebrow}</p><h2>{t.plans.title}</h2></div>
    <div class="plans">{t.plans.items.map((plan, i) => <article class:list={["plan", {featured: i === 1}]}><div><span class="plan-tag">{plan.tag}</span><h3>{plan.name}</h3><p>{plan.body}</p></div><ul>{plan.bullets.map((bullet) => <li>{bullet}</li>)}</ul><a href={diagnostic}>{t.plans.cta}<span>→</span></a></article>)}</div>
  </section>

  <section class="section shell fit">
    <article><h2>{t.fit.title}</h2><ul>{t.fit.good.map((item) => <li><span>✓</span>{item}</li>)}</ul></article>
    <article class="muted"><h2>{t.fit.avoidTitle}</h2><ul>{t.fit.avoid.map((item) => <li><span>—</span>{item}</li>)}</ul></article>
  </section>

  <section class="section shell about" id="quienes-somos">
    <div class="portrait"><img src="/assets/gerardo-navas.jpg" width="1122" height="1402" loading="lazy" alt={`${t.about.name}, ${t.about.role}`} /></div>
    <div><p class="eyebrow">{t.about.eyebrow}</p><h2>{t.about.title}</h2><blockquote>“{t.about.quote}”</blockquote><p class="signature"><strong>{t.about.name}</strong><span>{t.about.role}</span></p></div>
  </section>

  <section class="section shell faq">
    <div class="section-intro"><p class="eyebrow">{t.faq.eyebrow}</p><h2>{t.faq.title}</h2></div>
    <div class="faq-list">{t.faq.items.map((item) => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div>
  </section>

  <section class="final-cta"><div class="shell"><p class="eyebrow">{t.final.eyebrow}</p><h2>{t.final.title}</h2><p>{t.final.body}</p><a class="button light" href={diagnostic}>{t.final.cta}<span>→</span></a></div></section>
</main>

<footer><div class="shell footer-inner"><div><img src="/assets/logo-lockup-light.webp" width="1084" height="246" alt="Automate IT"/><p>{t.footer.line}</p></div><div class="footer-links"><a href={`${root}/blog`}>{t.nav.blog}</a><a href={`${root}/privacidad`}>{t.footer.privacy}</a><a href={`${root}/terminos`}>{t.footer.terms}</a></div><p class="copyright">© {new Date().getFullYear()} {t.footer.rights}</p></div></footer>

<style>
  :global(body){background:#fff;background-image:none;color:#0a0e1a}
  .shell{width:min(1180px,calc(100% - 40px));margin-inline:auto}
  .site-nav{height:82px;display:flex;align-items:center;gap:38px;width:min(1220px,calc(100% - 40px));margin:auto;border-bottom:1px solid #e5e8ee}
  .brand{display:block;width:190px}.brand img{display:block;width:100%;height:auto}.site-nav nav{display:flex;gap:28px;margin-left:auto;font-size:14px;font-weight:600;color:#344563}.site-nav nav a:hover{color:#0052cc}.nav-actions{display:flex;align-items:center;gap:14px}.lang{font-size:13px;font-weight:700;color:#5e6c84}
  .mobile-menu{display:none;position:relative}.mobile-menu summary{display:grid;gap:4px;padding:10px;cursor:pointer;list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:22px;height:2px;background:#0a0e1a;border-radius:2px}.mobile-menu nav{position:absolute;right:0;top:48px;z-index:20;display:grid!important;min-width:210px;padding:12px;background:#fff;border:1px solid #dfe5ee;border-radius:14px;box-shadow:0 16px 40px rgba(20,39,74,.16)}.mobile-menu nav a{padding:11px 12px;border-radius:8px}.mobile-menu nav a:hover{background:#f3f6fa}
  .button{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:52px;padding:0 24px;border-radius:14px;background:#0052cc;color:#fff;font-weight:700;font-size:15px;box-shadow:0 8px 22px rgba(0,82,204,.18);transition:transform .2s,background .2s}.button:hover{background:#003da5;transform:translateY(-2px)}.button-small{min-height:42px;padding:0 18px;border-radius:12px;font-size:13px}.button.light{background:#fff;color:#003da5}
  .hero{display:grid;grid-template-columns:1.03fr .97fr;gap:76px;align-items:center;padding-block:96px 90px}.hero-copy{max-width:640px}.eyebrow{margin:0 0 26px;color:#0052cc;font-weight:700;font-size:12px;letter-spacing:.18em;text-transform:uppercase}.hero h1{font-size:clamp(42px,4vw,58px);line-height:1.14;letter-spacing:-.03em;max-width:640px;color:#0a0e1a}.hero h1 span{color:#0052cc}.lead{font-size:19px;line-height:1.7;color:#45546d;max-width:590px;margin:30px 0 34px}.hero-actions{display:flex;align-items:center;gap:28px}.text-link{display:inline-flex;align-items:center;gap:10px;color:#24324b;font-weight:700}.note{margin:13px 0 0;color:#7a8496;font-size:12px}
  .dashboard{position:relative;background:#f7f9fc;border:1px solid #dfe5ee;border-radius:26px;padding:20px;box-shadow:0 28px 70px rgba(20,39,74,.14);transform:rotate(1deg)}.dashboard:before{content:"";position:absolute;inset:22px -22px -22px 22px;z-index:-1;border-radius:26px;background:#e6efff}.dash-head,.dash-title,.dash-row{display:flex;align-items:center}.dash-head{justify-content:space-between;font-size:11px;color:#77839a;text-transform:uppercase;letter-spacing:.12em}.live{display:flex;gap:7px;align-items:center;color:#3b6b25;font-weight:700}.live i{width:8px;height:8px;border-radius:99px;background:#aadd00}.dash-title{justify-content:space-between;margin:22px 0 14px}.dash-title p{font-size:18px;font-weight:700;margin:0}.dash-title strong{color:#98a2b3}.metric{display:grid;grid-template-columns:1fr 1fr;align-items:end;background:#fff;border:1px solid #e6e9ef;border-radius:18px;padding:20px}.metric span{display:block;color:#718096;font-size:11px}.metric b{font-family:"Anton",Montserrat,system-ui,sans-serif;font-size:44px;font-weight:400;line-height:1}.metric svg{width:100%}.dash-rows{margin-top:12px}.dash-row{gap:12px;padding:14px 4px;border-bottom:1px solid #e2e7ef;font-size:12px;color:#43516a}.dash-row:last-child{border:0}.dash-row b{margin-left:auto;font-size:11px;color:#60708a}.row-icon{display:grid;place-items:center;width:29px;height:29px;border-radius:9px;background:#e7efff;color:#0052cc;font-weight:800}.row-icon.i1{background:#edf8e1;color:#568300}.row-icon.i2{background:#fff0e8;color:#b45421}
  .ticker{display:flex;justify-content:center;gap:40px;overflow:hidden;padding:16px 20px;background:#050a18;color:#fff;white-space:nowrap}.ticker span{display:flex;gap:40px;font-size:11px;letter-spacing:.16em}.ticker i{color:#aadd00;font-style:normal}
  .section{padding-block:110px}.section-intro{max-width:720px}.section-intro h2,.about h2,.fit h2,.final-cta h2{font-size:clamp(38px,4.2vw,58px);letter-spacing:-.02em}.section-intro>p:last-child{color:#56647a;font-size:18px;line-height:1.75;margin:24px 0 0}.three-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:58px}.plain-card{border-top:2px solid #0a0e1a;padding:28px 4px}.number{font-family:"Anton",Montserrat,system-ui,sans-serif;font-size:13px;color:#0052cc}.plain-card h3,.steps h3{font-size:23px;margin:34px 0 12px}.plain-card p,.steps p,.plan p{color:#60708a;line-height:1.7;margin:0}
  .case-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;margin-top:58px}.case-card{display:flex;flex-direction:column}.case-grid .case-card:nth-child(1){grid-column:1/3}.case-grid .case-card:nth-child(2){grid-column:3/5}.case-grid .case-card:nth-child(3){grid-column:5/7}.case-grid .case-card:nth-child(4){grid-column:2/4}.case-grid .case-card:nth-child(5){grid-column:4/6}.case-label{font-size:11px;font-weight:700;color:#77839a;text-transform:uppercase;letter-spacing:.12em;margin-bottom:16px}.case-card h3{font-size:21px;margin:0 0 16px}.case-field{margin-bottom:12px}.case-field:last-child{margin-bottom:0}.case-field b{color:#0a0e1a}.case-closing{max-width:720px;margin:56px auto 0;padding-top:36px;border-top:1px solid #dce2ea;font-size:19px;line-height:1.7;color:#25324a;text-align:center}
  .process{background:#f3f6fa}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:60px;border:1px solid #dce2ea;border-radius:22px;overflow:hidden;background:#fff}.steps article{padding:30px;border-right:1px solid #dce2ea;min-height:250px}.steps article:last-child{border:0}.steps article>span{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#e6efff;color:#0052cc;font-weight:800}.steps h3{margin-top:42px}
  .plans{display:grid;gap:15px;margin-top:56px}.plan{display:grid;grid-template-columns:1.1fr 1fr .72fr;gap:38px;align-items:center;border:1px solid #dfe3ea;border-radius:22px;padding:32px 36px;background:#fff}.plan.featured{border-color:#98bdf5;box-shadow:0 16px 40px rgba(0,82,204,.09)}.plan-tag{font-size:11px;font-weight:700;color:#0052cc;text-transform:uppercase;letter-spacing:.14em}.plan h3{font-size:31px;margin:10px 0}.plan ul{list-style:none;padding:0;margin:0}.plan li{padding:7px 0;color:#43516a;font-size:14px}.plan li:before{content:"✓";color:#679900;font-weight:800;margin-right:10px}.plan>a{justify-self:end;font-weight:700;color:#0052cc}.plan>a span{margin-left:12px}
  .fit{display:grid;grid-template-columns:1fr 1fr;gap:22px}.fit article{padding:48px;border-radius:24px;background:#071126;color:#fff}.fit article.muted{background:#f3f5f8;color:#0a0e1a}.fit h2{font-size:36px}.fit ul{list-style:none;padding:0;margin:30px 0 0}.fit li{display:flex;gap:15px;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.12)}.fit .muted li{border-color:#dde2e9}.fit li span{color:#aadd00;font-weight:800}.fit .muted li span{color:#8792a4}
  .about{display:grid;grid-template-columns:.75fr 1.25fr;gap:80px;align-items:center}.portrait{border-radius:28px;overflow:hidden;background:#d8d1c9;box-shadow:18px 18px 0 #e6efff}.portrait img{display:block;width:100%;height:auto}.about blockquote{font-family:"Anton",Montserrat,system-ui,sans-serif;font-size:clamp(24px,2.6vw,38px);line-height:1.35;margin:32px 0;color:#25324a}.signature{display:flex;flex-direction:column;margin-top:28px}.signature span{color:#718096;font-size:14px;margin-top:4px}
  .faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.faq-list details{border-bottom:1px solid #dce1e8;padding:24px 0}.faq-list summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer;font-weight:700;font-size:18px;list-style:none}.faq-list summary span{color:#0052cc;font-size:24px}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list details p{color:#5e6c84;line-height:1.7;margin:16px 40px 0 0}
  .final-cta{padding:100px 0;background:#0052cc;color:#fff;text-align:center}.final-cta .eyebrow{color:#d7e6ff}.final-cta h2{max-width:820px;margin:auto}.final-cta p:not(.eyebrow){max-width:620px;margin:22px auto 30px;color:#e6efff;font-size:18px}.final-cta .button{margin:auto}
  footer{background:#050a18;color:#fff;padding:58px 0 30px}.footer-inner{display:grid;grid-template-columns:1fr auto;gap:38px;align-items:start}.footer-inner img{width:180px;height:auto;display:block}.footer-inner>div>p{color:#9da8ba;font-size:14px}.footer-links{display:flex;gap:25px;color:#c6ceda;font-size:13px}.copyright{grid-column:1/-1;border-top:1px solid #263147;padding-top:22px;color:#7f8a9c;font-size:12px;margin:0}
  @media(max-width:850px){.site-nav{height:70px}.brand{width:155px}.site-nav>nav{display:none}.nav-actions{margin-left:auto}.mobile-menu{display:block}.hero{grid-template-columns:1fr;gap:50px;padding-block:70px}.hero h1{font-size:48px;line-height:1.16}.dashboard{max-width:610px}.steps{grid-template-columns:1fr 1fr}.steps article:nth-child(2){border-right:0}.steps article:nth-child(-n+2){border-bottom:1px solid #dce2ea}.case-grid{grid-template-columns:1fr 1fr}.case-grid .case-card{grid-column:auto!important}.plan{grid-template-columns:1fr 1fr}.plan>a{grid-column:1/-1;justify-self:start}.about{gap:45px}.faq{grid-template-columns:1fr;gap:42px}}
  @media(max-width:600px){.shell{width:min(100% - 30px,1180px)}.site-nav{width:calc(100% - 30px)}.brand{width:138px}.lang{display:none}.button-small{min-height:40px;padding-inline:14px}.hero{padding-block:54px 64px}.hero .eyebrow{margin-bottom:22px}.hero h1{font-size:38px;line-height:1.14;letter-spacing:-.025em}.lead{font-size:17px;max-width:34rem;margin:26px 0 28px}.hero-actions{align-items:stretch;flex-direction:column;gap:18px}.hero-actions .button{width:100%}.text-link{justify-content:center}.dashboard{padding:14px;border-radius:22px;transform:none}.dashboard:before{inset:14px -8px -12px 8px}.metric{padding:16px}.metric b{font-size:36px}.dash-row b{max-width:90px;text-align:right}.ticker{justify-content:flex-start}.section{padding-block:76px}.section-intro h2,.about h2,.final-cta h2{font-size:36px}.three-grid{grid-template-columns:1fr;margin-top:38px}.plain-card h3{margin-top:20px}.case-grid{grid-template-columns:1fr;margin-top:38px}.case-closing{font-size:17px;margin-top:38px;padding-top:28px}.steps{grid-template-columns:1fr;border-radius:18px}.steps article{min-height:auto;border-right:0!important;border-bottom:1px solid #dce2ea!important}.steps article:last-child{border-bottom:0!important}.steps h3{margin-top:24px}.plan{grid-template-columns:1fr;padding:28px 24px;gap:24px}.plan>a{grid-column:auto}.fit{grid-template-columns:1fr}.fit article{padding:32px 25px}.fit h2{font-size:29px}.about{grid-template-columns:1fr;gap:48px}.portrait{width:88%;margin:auto}.faq-list summary{font-size:16px}.final-cta{padding:76px 0}.footer-inner{grid-template-columns:1fr}.footer-links{flex-wrap:wrap}.copyright{grid-column:auto}.footer-inner img{width:160px}}
</style>
