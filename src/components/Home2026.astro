  .lang-toggle-flag{width:16px;height:12px;border-radius:2px;object-fit:cover;display:inline-block;vertical-align:middle}
  .lang-toggle-option:not(.is-active):hover{color:#0a0e1a}
  .lang-toggle-tooltip{position:absolute;bottom:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(6px);background:rgba(5,10,24,.95);border:1px solid rgba(0,153,187,.35);color:#0099bb;font-weight:600;font-size:11px;padding:6px 11px;border-radius:7px;white-space:nowrap;z-index:10;opacity:0;pointer-events:none;animation:langTipIn .4s ease-out 2s forwards,langTipOut .3s ease-out 5s forwards}
  .lang-toggle-tooltip::after{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);border:5px solid transparent;border-top-color:rgba(0,153,187,.35)}
  @keyframes langTipIn{to{opacity:1;transform:translateX(-50%) translateY(0)}}
