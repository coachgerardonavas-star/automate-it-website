  .hero{padding-block:96px 40px}.hero-copy{max-width:680px}.eyebrow{margin:0 0 26px;color:#0052cc;font-weight:700;font-size:12px;letter-spacing:.18em;text-transform:uppercase}.hero h1{font-size:clamp(42px,4vw,58px);line-height:1.14;letter-spacing:-.03em;max-width:680px;color:#0a0e1a}.hero h1 .typewriter-cursor{color:currentColor;animation:blink 530ms step-end infinite}@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}@media(prefers-reduced-motion:reduce){.hero h1 .typewriter-cursor{display:none}}.lead{font-size:19px;line-height:1.7;color:#45546d;max-width:590px;margin:30px 0 34px}.hero-actions{display:flex;align-items:center;gap:28px}
