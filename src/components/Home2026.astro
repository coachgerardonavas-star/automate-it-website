  .lang-toggle-option{padding:9px 16px;font-weight:700;font-size:12px;letter-spacing:.05em;display:flex;align-items:center;gap:6px;color:#5e6c84;position:relative;z-index:1;user-select:none;text-decoration:none;transition:color .2s ease}
