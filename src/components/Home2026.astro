---
import { translations, type Lang } from "../i18n/translations";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang].home2026;
const root = lang === "en" ? "/en" : "";
const diagnostic = lang === "en" ? "/en/diagnostic" : "/diagnostico";
---

<header class="site-nav">
  <a class="brand" href={`${root}/`} aria-label="Automate IT">
    <img src="/assets/logo-lockup.webp" width="1084" height="246" alt="Automate IT — Your Biz. Upgraded." />
  </a>
  <nav aria-label={lang === "en" ? "Main" : "Principal"}>
    <a href="#como-funciona">{t.nav.how}</a><a href="#planes">{t.nav.plans}</a><a href="#quienes-somos">{t.nav.about}</a><a href={`${root}/blog`}>{t.nav.blog}</a>
  </nav>
  <div class="nav-actions">
    <div class="lang-toggle lang-toggle--bar" data-active={lang} role="group" aria-label={lang === "en" ? "Language switch" : "Selector de idioma"}>
      <span class="lang-toggle-pill" aria-hidden="true"></span>
      {lang === "es" ? (
        <span class="lang-toggle-option is-active" aria-current="true"><img src="https://flagcdn.com/ve.svg" width="16" height="12" alt="VE" class="lang-toggle-flag" /><span>ES</span></span>
      ) : (
        <a href="/" class="lang-toggle-option"><img src="https://flagcdn.com/ve.svg" width="16" height="12" alt="VE" class="lang-toggle-flag" /><span>ES</span></a>
      )}
      {lang === "en" ? (
        <span class="lang-toggle-option is-active" aria-current="true"><img src="https://flagcdn.com/us.svg" width="16" height="12" alt="US" class="lang-toggle-flag" /><span>EN</span></span>
      ) : (
        <a href="/en/" class="lang-toggle-option"><img src="https://flagcdn.com/us.svg" width="16" height="12" alt="US" class="lang-toggle-flag" /><span>EN</span></a>
      )}
      {lang === "es" && <span class="lang-toggle-tooltip" role="tooltip">Switch to English →</span>}
    </div>
    <a class="button button-small" href={diagnostic}>{t.nav.diagnostic}</a>
  </div>
  <details class="mobile-menu">
    <summary aria-label={lang === "en" ? "Open menu" : "Abrir menú"}><span></span><span></span><span></span></summary>
    <nav aria-label={lang === "en" ? "Mobile navigation" : "Navegación móvil"}>
      <a href="#como-funciona">{t.nav.how}</a><a href="#planes">{t.nav.plans}</a><a href="#quienes-somos">{t.nav.about}</a><a href={`${root}/blog`}>{t.nav.blog}</a>
      <div class="lang-toggle lang-toggle--menu" data-active={lang} role="group" aria-label={lang === "en" ? "Language switch" : "Selector de idioma"}>
        <span class="lang-toggle-pill" aria-hidden="true"></span>
        {lang === "es" ? (
          <span class="lang-toggle-option is-active" aria-current="true"><img src="https://flagcdn.com/ve.svg" width="16" height="12" alt="VE" class="lang-toggle-flag" /><span>ES</span></span>
        ) : (
          <a href="/" class="lang-toggle-option"><img src="https://flagcdn.com/ve.svg" width="16" height="12" alt="VE" class="lang-toggle-flag" /><span>ES</span></a>
        )}
        {lang === "en" ? (
          <span class="lang-toggle-option is-active" aria-current="true"><img src="https://flagcdn.com/us.svg" width="16" height="12" alt="US" class="lang-toggle-flag" /><span>EN</span></span>
        ) : (
          <a href="/en/" class="lang-toggle-option"><img src="https://flagcdn.com/us.svg" width="16" height="12" alt="US" class="lang-toggle-flag" /><span>EN</span></a>
        )}
      </div>
    </nav>
  </details>
</header>

<main>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>
        {t.hero.h1Line1}{" "}
        <span
          id="typewriter"
          style={`color:${t.hero.heroPhraseColors[0]}`}
          aria-live="polite"
          data-phrases={JSON.stringify(t.hero.heroPhrases)}
          data-colors={JSON.stringify(t.hero.heroPhraseColors)}
        ><span id="typewriter-text">{t.hero.heroPhrases[0]}</span><span
            class="typewriter-cursor"
            aria-hidden="true">|</span></span>
      </h1>
      <p class="lead">{t.hero.body}</p>
      <div class="hero-actions">
        <a class="button" href={diagnostic}>{t.hero.primary}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section shell problem">
    <div class="section-intro"><p class="eyebrow">{t.problem.eyebrow}</p><h2>{t.problem.title}</h2><p>{t.problem.body}</p></div>
    <div class="case-grid">{t.problem.items.map((item) => (
      <article class="plain-card case-card">
        <span class="case-label">{t.problem.label}</span>
        <h3>{item.titulo}</h3>
        <p class="case-field"><b>{t.problem.problemaLabel}:</b> {item.problema}</p>
        <p class="case-field"><b>{t.problem.solucionLabel}:</b> {item.solucion}</p>
      </article>
    ))}</div>
    <p class="case-closing">{t.problem.closing}</p>
  </section>

  <div class="ticker">{t.ticker.map((item) => <span>{item}<i>✦</i></span>)}</div>

  <section class="section process" id="como-funciona">
    <div class="shell"><div class="section-intro"><p class="eyebrow">{t.process.eyebrow}</p><h2>{t.process.title}</h2></div>
      <div class="steps">{t.process.steps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
    </div>
  </section>

  <section class="section shell" id="planes">
    <div class="section-intro"><p class="eyebrow">{t.plans.eyebrow}</p><h2>{t.plans.title}</h2></div>
    <div class="plans">{t.plans.items.map((plan, i) => <article class:list={["plan", {featured: i === 1}]}><div><span class="plan-tag">{plan.tag}</span><h3>{plan.name}</h3><p>{plan.body}</p></div><ul>{plan.bullets.map((bullet) => <li>{bullet}</li>)}</ul><a href={diagnostic}>{t.plans.cta}<span>→</span></a></article>)}</div>
  </section>

  <section class="section shell fit">
    <article><h2>{t.fit.title}</h2><ul>{t.fit.good.map((item) => <li><span>✓</span>{item}</li>)}</ul></article>
    <article class="muted"><h2>{t.fit.avoidTitle}</h2><ul>{t.fit.avoid.map((item) => <li><span>—</span>{item}</li>)}</ul></article>
  </section>

  <section class="section shell about" id="quienes-somos">
    <div class="portrait"><img src="/assets/gerardo-navas.jpg" width="1122" height="1402" loading="lazy" alt={`${t.about.name}, ${t.about.role}`} /></div>
    <div><p class="eyebrow">{t.about.eyebrow}</p><h2>{t.about.title}</h2><blockquote>“{t.about.quote}”</blockquote><p class="signature"><strong>{t.about.name}</strong><span>{t.about.role}</span></p></div>
  </section>

  <section class="section shell faq">
    <div class="section-intro"><p class="eyebrow">{t.faq.eyebrow}</p><h2>{t.faq.title}</h2></div>
    <div class="faq-list">{t.faq.items.map((item) => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div>
  </section>

  <section class="final-cta"><div class="shell"><p class="eyebrow">{t.final.eyebrow}</p><h2>{t.final.title}</h2><p>{t.final.body}</p><a class="button light" href={diagnostic}>{t.final.cta}<span>→</span></a></div></section>
</main>

<footer><div class="shell footer-inner"><div><img src="/assets/logo-lockup-light.webp" width="1084" height="246" alt="Automate IT"/><p>{t.footer.line}</p></div><div class="footer-links"><a href={`${root}/blog`}>{t.nav.blog}</a><a href={`${root}/privacidad`}>{t.footer.privacy}</a><a href={`${root}/terminos`}>{t.footer.terms}</a></div><p class="copyright">© {new Date().getFullYear()} {t.footer.rights}</p></div></footer>

<style>
  :global(body){background:#fff;background-image:none;color:#0a0e1a}
  .shell{width:min(1180px,calc(100% - 40px));margin-inline:auto}
  .site-nav{height:82px;display:flex;align-items:center;gap:38px;width:min(1220px,calc(100% - 40px));margin:auto;border-bottom:1px solid #e5e8ee}
  .brand{display:block;width:190px}.brand img{display:block;width:100%;height:auto}.site-nav nav{display:flex;gap:28px;margin-left:auto;font-size:14px;font-weight:600;color:#344563}.site-nav nav a:hover{color:#0052cc}.nav-actions{display:flex;align-items:center;gap:14px}
  .mobile-menu{display:none;position:relative}.mobile-menu summary{display:grid;gap:4px;padding:10px;cursor:pointer;list-style:none}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{display:block;width:22px;height:2px;background:#0a0e1a;border-radius:2px}.mobile-menu nav{position:absolute;right:0;top:48px;z-index:20;display:grid!important;min-width:210px;padding:12px;background:#fff;border:1px solid #dfe5ee;border-radius:14px;box-shadow:0 16px 40px rgba(20,39,74,.16)}.mobile-menu nav > a{padding:11px 12px;border-radius:8px}.mobile-menu nav > a:hover{background:#f3f6fa}

  /* Selector de idioma — pill deslizante + banderas (mismo diseño que Nav.astro) */
  .lang-toggle{position:relative;display:inline-flex;align-items:center;background:rgba(0,82,204,.06);border:1px solid rgba(0,153,187,.3);border-radius:10px;overflow:hidden;cursor:pointer;transition:border-color .2s ease,box-shadow .2s ease}
  .lang-toggle:hover{border-color:#0099bb;box-shadow:0 0 16px rgba(0,153,187,.15)}
  .lang-toggle::before{content:"";position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.12),transparent);animation:shineLoop 3s ease-in-out infinite;pointer-events:none;z-index:2}
  @keyframes shineLoop{0%{left:-80%}50%{left:120%}100%{left:120%}}
  .lang-toggle-pill{position:absolute;top:3px;left:3px;height:calc(100% - 6px);width:calc(50% - 3px);background:#0052cc;border-radius:7px;box-shadow:0 0 8px rgba(0,82,204,.6);transition:transform .28s cubic-bezier(.4,0,.2,1);z-index:0}
