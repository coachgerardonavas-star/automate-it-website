  .case-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;margin-top:58px}.case-card{display:flex;flex-direction:column}.case-grid .case-card:nth-child(1){grid-column:1/3}.case-grid .case-card:nth-child(2){grid-column:3/5}.case-grid .case-card:nth-child(3){grid-column:5/7}.case-grid .case-card:nth-child(4){grid-column:2/4}.case-grid .case-card:nth-child(5){grid-column:4/6}.case-label{font-size:11px;font-weight:700;color:#77839a;text-transform:uppercase;letter-spacing:.12em;margin-bottom:16px}.case-card h3{font-size:21px;margin:0 0 16px}.case-field{margin-bottom:12px}.case-field:last-child{margin-bottom:0}.case-field b{color:#0a0e1a}.case-closing{max-width:720px;margin:56px auto 0;padding-top:36px;border-top:1px solid #dce2ea;font-size:19px;line-height:1.7;color:#25324a;text-align:center}
  .process{background:#f3f6fa}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:60px;border:1px solid #dce2ea;border-radius:22px;overflow:hidden;background:#fff}.steps article{padding:30px;border-right:1px solid #dce2ea;min-height:250px}.steps article:last-child{border:0}.steps article>span{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#e6efff;color:#0052cc;font-weight:800}.steps h3{margin-top:42px}
  .plans{display:grid;gap:15px;margin-top:56px}.plan{display:grid;grid-template-columns:1.1fr 1fr .72fr;gap:38px;align-items:center;border:1px solid #dfe3ea;border-radius:22px;padding:32px 36px;background:#fff}.plan.featured{border-color:#98bdf5;box-shadow:0 16px 40px rgba(0,82,204,.09)}.plan-tag{font-size:11px;font-weight:700;color:#0052cc;text-transform:uppercase;letter-spacing:.14em}.plan h3{font-size:31px;margin:10px 0}.plan ul{list-style:none;padding:0;margin:0}.plan li{padding:7px 0;color:#43516a;font-size:14px}.plan li:before{content:"✓";color:#679900;font-weight:800;margin-right:10px}.plan>a{justify-self:end;font-weight:700;color:#0052cc}.plan>a span{margin-left:12px}
  .fit{display:grid;grid-template-columns:1fr 1fr;gap:22px}.fit article{padding:48px;border-radius:24px;background:#071126;color:#fff}.fit article.muted{background:#f3f5f8;color:#0a0e1a}.fit h2{font-size:36px}.fit ul{list-style:none;padding:0;margin:30px 0 0}.fit li{display:flex;gap:15px;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.12)}.fit .muted li{border-color:#dde2e9}.fit li span{color:#aadd00;font-weight:800}.fit .muted li span{color:#8792a4}
  .about{display:grid;grid-template-columns:.75fr 1.25fr;gap:80px;align-items:center}.portrait{border-radius:28px;overflow:hidden;background:#d8d1c9;box-shadow:18px 18px 0 #e6efff}.portrait img{display:block;width:100%;height:auto}.about blockquote{font-family:"Anton",Montserrat,system-ui,sans-serif;font-size:clamp(24px,2.6vw,38px);line-height:1.35;margin:32px 0;color:#25324a}.signature{display:flex;flex-direction:column;margin-top:28px}.signature span{color:#718096;font-size:14px;margin-top:4px}
  .faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.faq-list details{border-bottom:1px solid #dce1e8;padding:24px 0}.faq-list summary{display:flex;justify-content:space-between;gap:20px;cursor:pointer;font-weight:700;font-size:18px;list-style:none}.faq-list summary span{color:#0052cc;font-size:24px}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list details p{color:#5e6c84;line-height:1.7;margin:16px 40px 0 0}
  .final-cta{padding:100px 0;background:#0052cc;color:#fff;text-align:center}.final-cta .eyebrow{color:#d7e6ff}.final-cta h2{max-width:820px;margin:auto}.final-cta p:not(.eyebrow){max-width:620px;margin:22px auto 30px;color:#e6efff;font-size:18px}.final-cta .button{margin:auto}
  footer{background:#050a18;color:#fff;padding:58px 0 30px}.footer-inner{display:grid;grid-template-columns:1fr auto;gap:38px;align-items:start}.footer-inner img{width:180px;height:auto;display:block}.footer-inner>div>p{color:#9da8ba;font-size:14px}.footer-links{display:flex;gap:25px;color:#c6ceda;font-size:13px}.copyright{grid-column:1/-1;border-top:1px solid #263147;padding-top:22px;color:#7f8a9c;font-size:12px;margin:0}
  @media(max-width:850px){.site-nav{height:70px}.brand{width:155px}.site-nav>nav{display:none}.nav-actions{margin-left:auto}.mobile-menu{display:block}.hero{padding-block:70px 30px}.hero h1{font-size:48px;line-height:1.16}.steps{grid-template-columns:1fr 1fr}.steps article:nth-child(2){border-right:0}.steps article:nth-child(-n+2){border-bottom:1px solid #dce2ea}.case-grid{grid-template-columns:1fr 1fr}.case-grid .case-card{grid-column:auto!important}.plan{grid-template-columns:1fr 1fr}.plan>a{grid-column:1/-1;justify-self:start}.about{gap:45px}.faq{grid-template-columns:1fr;gap:42px}}
  @media(max-width:600px){.shell{width:min(100% - 30px,1180px)}.site-nav{width:calc(100% - 30px)}.brand{width:138px}.lang-toggle--bar{display:none}.button-small{min-height:40px;padding-inline:14px}.hero{padding-block:54px 24px}.hero .eyebrow{margin-bottom:22px}.hero h1{font-size:38px;line-height:1.14;letter-spacing:-.025em}.lead{font-size:17px;max-width:34rem;margin:26px 0 28px}.hero-actions{align-items:stretch;flex-direction:column;gap:18px}.hero-actions .button{width:100%}.ticker{justify-content:flex-start}.section{padding-block:76px}.section.problem{padding-top:30px}.section-intro h2,.about h2,.final-cta h2{font-size:36px}.three-grid{grid-template-columns:1fr;margin-top:38px}.plain-card h3{margin-top:20px}.case-grid{grid-template-columns:1fr;margin-top:38px}.case-closing{font-size:17px;margin-top:38px;padding-top:28px}.steps{grid-template-columns:1fr;border-radius:18px}.steps article{min-height:auto;border-right:0!important;border-bottom:1px solid #dce2ea!important}.steps article:last-child{border-bottom:0!important}.steps h3{margin-top:24px}.plan{grid-template-columns:1fr;padding:28px 24px;gap:24px}.plan>a{grid-column:auto}.fit{grid-template-columns:1fr}.fit article{padding:32px 25px}.fit h2{font-size:29px}.about{grid-template-columns:1fr;gap:48px}.portrait{width:88%;margin:auto}.faq-list summary{font-size:16px}.final-cta{padding:76px 0}.footer-inner{grid-template-columns:1fr}.footer-links{flex-wrap:wrap}.copyright{grid-column:auto}.footer-inner img{width:160px}}
</style>

<script>
  // Palabra final del H1 del hero: rotativa y con color por frase.
  // Frases y colores vienen de translations.ts (`home2026.hero.heroPhrases`
  // / `heroPhraseColors`, mismo índice) vía data-phrases / data-colors.
  const TYPE_MS = 60;
  const DELETE_MS = 30;
  const HOLD_MS = 2000;
  const BETWEEN_MS = 400;

  const textEl = document.getElementById("typewriter-text");
  const container = document.getElementById("typewriter");

  let PHRASES = [];
  try {
    PHRASES = JSON.parse(container?.dataset.phrases || "[]");
  } catch {
    PHRASES = [];
  }
  if (!PHRASES.length && textEl) PHRASES = [textEl.textContent || ""];

  let COLORS = [];
  try {
    COLORS = JSON.parse(container?.dataset.colors || "[]");
  } catch {
    COLORS = [];
  }

  const cursor = container?.querySelector(".typewriter-cursor");

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (textEl && container && !prefersReducedMotion) {
    let phraseIndex = 0;
    let charIndex = PHRASES[0].length;
    textEl.textContent = PHRASES[0];

    const setCursor = (visible) => {
      if (cursor) cursor.style.visibility = visible ? "visible" : "hidden";
    };

    const type = () => {
      const current = PHRASES[phraseIndex];
      setCursor(true);
      if (charIndex < current.length) {
        charIndex += 1;
        textEl.textContent = current.slice(0, charIndex);
        window.setTimeout(type, TYPE_MS);
      } else {
        window.setTimeout(erase, HOLD_MS);
      }
    };

    const erase = () => {
      const current = PHRASES[phraseIndex];
      setCursor(false);
      if (charIndex > 0) {
        charIndex -= 1;
        textEl.textContent = current.slice(0, charIndex);
        window.setTimeout(erase, DELETE_MS);
      } else {
        phraseIndex = (phraseIndex + 1) % PHRASES.length;
        if (COLORS.length && container) {
          container.style.color = COLORS[phraseIndex % COLORS.length];
        }
        window.setTimeout(type, BETWEEN_MS);
      }
    };

    window.setTimeout(erase, HOLD_MS);
  }
</script>
