---
import { translations, type Lang } from "../i18n/translations";
import { jsonLd } from "../lib/jsonld";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
const t = translations[lang].servicios;
const diagPath = lang === "en" ? "/en/diagnostic" : "/diagnostico";

// El sitio ya no vende por autoservicio: el modelo es diagnóstico → SOW
// firmado → 50% al firmar → instalación → suscripción a los 30 días con
// mínimo de 3 meses. Nada de eso cabe en un botón de checkout, así que el
// CTA de cada plan lleva al diagnóstico. Ver `src/lib/stripe.ts`.

const serviceNames =
  lang === "es"
    ? [
        "Asistente — Miembro digital",
        "Estratega — Miembro digital",
        "Manager — Miembro digital",
      ]
    : [
        "Assistant — Digital team member",
        "Strategist — Digital team member",
        "Manager — Digital team member",
      ];

const orgRef = {
  "@type": "Organization",
  name: "Automate IT",
  url: "https://yourbizupgraded.com",
};

const serviceSchemas = t.plans.map((plan, i) => {
  const priceNumber = plan.price.replace(/[^0-9.]/g, "");
  return {
    "@context": "https://schema.org",
    "@type": "Service",
    name: serviceNames[i],
    description: plan.description,
    provider: orgRef,
    areaServed: "United States",
    offers: {
      "@type": "Offer",
      price: priceNumber,
      priceCurrency: "USD",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: priceNumber,
        priceCurrency: "USD",
        billingIncrement: 1,
        unitCode: "MON",
      },
    },
  };
});
---

{
  serviceSchemas.map((schema) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(schema)}
    />
  ))
}

<section
  id="planes"
  class="py-20 sm:py-28 border-t border-[var(--color-border)] reveal-on-scroll"
>
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <header class="max-w-3xl mb-12 sm:mb-16">
      <p class="text-sm sm:text-xs tracking-[0.28em] uppercase text-[var(--color-blue)] mb-4 font-semibold">
        {t.eyebrow}
      </p>
      <h2 class="font-heading text-3xl sm:text-5xl leading-tight mb-6">
        {t.titleLine1}<br />
        <span class="text-[var(--color-text-muted)]">{t.titleLine2}</span>
      </h2>
      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
        {t.subtitle}
      </p>
    </header>

    <div class="tilt-wrapper grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 mb-16 sm:mb-20">
      {
        /* Los planes con `hidden: true` (hoy el Professional/HIPAA) no se
           muestran: se venden solo cuando el prospecto los pide. La ficha
           completa sigue en translations.ts, no se borró. */
        t.plans.filter((plan) => !("hidden" in plan && plan.hidden)).map((plan) => (
          <article
            id={`plan-${plan.sku.toLowerCase()}`}
            class:list={[
              "tilt-card relative flex flex-col p-6 rounded-md bg-[var(--color-bg-soft)] shadow-[var(--shadow-card)] scroll-mt-20",
              plan.badge
                ? "border border-brand-lime/40 hover:border-brand-lime transition-all duration-200 ease-brand"
                : "card-glow",
            ]}
          >
            {plan.badge && (
              <span class="absolute -top-3 left-7 sm:left-8 inline-flex items-center px-3 py-1 rounded-full text-[10px] font-semibold tracking-widest uppercase bg-brand-lime text-[var(--color-text-primary)]">
                {plan.badge}
              </span>
            )}
            <p class="font-mono text-xs sm:text-[10px] tracking-widest uppercase text-[var(--color-text-subtle)] mb-3">
              {plan.sku}
            </p>
            <h3 class="font-heading text-2xl sm:text-3xl mb-2 leading-snug">
              {plan.name}
            </h3>
            <div class="mb-2 flex items-baseline gap-2">
              <span class="font-heading text-3xl sm:text-4xl text-[var(--color-text-primary)]">
                {plan.price}
              </span>
              <span class="text-sm sm:text-sm text-[var(--color-text-secondary)]">
                {plan.priceUnit}
              </span>
            </div>
            <p class="text-sm sm:text-xs text-[var(--color-text-secondary)] mb-4 font-mono">{plan.setup}</p>
            <p class="text-base sm:text-base text-[var(--color-text-secondary)] leading-relaxed mb-6">
              {plan.description}
            </p>
            <ul class="space-y-2.5 flex-1">
              {plan.features.map((feature) => (
                <li class="flex gap-3 text-sm sm:text-sm text-[var(--color-text-secondary)] leading-snug">
                  <span class="text-[var(--color-blue)] mt-0.5 shrink-0">→</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <a
                href={diagPath}
                class="btn-cta block mx-auto w-auto text-center px-8 py-3 rounded-sm text-sm font-semibold bg-[var(--color-blue)] text-white hover:bg-[var(--color-navy)] transition-colors duration-200 ease-brand"
              >
                {t.checkoutLabel}
              </a>
            </div>
            <a
              href={diagPath}
              class="mt-4 inline-block text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-navy)] transition-colors"
            >
              {t.planDiagnosticHint}
            </a>
          </article>
        ))
      }
    </div>

    {/* El grid de "módulos de canal" (Voz / WhatsApp / CRM) se eliminó el
        5-ago-2026: el catálogo dejó de venderse por canales y pasó a venderse
        por nivel de autonomía. Un cliente ya no elige canales — elige cuánto
        quiere delegar, y qué herramientas se usan lo define el SOW. */}

    <div class="mb-12 sm:mb-14">
      <p class="text-sm sm:text-xs tracking-[0.28em] uppercase text-[var(--color-blue)] mb-6 font-semibold">
        {t.examplesEyebrow}
      </p>
      <div class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg-soft)] divide-y divide-[var(--color-border)]">
        {
          t.examples.map((ex) => (
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-4 px-5 sm:px-6 py-4">
              <div class="min-w-0 flex-1">
                <p class="text-sm sm:text-base text-[var(--color-text-primary)] font-semibold">
                  {ex.label}
                </p>
                <p class="text-sm sm:text-xs text-[var(--color-text-muted)] mt-0.5 font-mono">
                  {ex.detail}
                </p>
              </div>
              <p class="font-heading text-xl sm:text-2xl text-[var(--color-blue)] font-mono shrink-0">
                {ex.total}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="text-center">
      <a
        href={diagPath}
        class="btn-cta inline-flex items-center justify-center px-6 py-3 rounded-sm font-semibold bg-[var(--color-blue)] text-white hover:bg-[var(--color-navy)] transition-colors duration-200 ease-brand"
      >
        {t.cta}
      </a>
      <p class="mt-4 text-sm sm:text-sm text-[var(--color-text-secondary)] max-w-md mx-auto">
        {t.ctaHint}
      </p>
    </div>
  </div>
</section>

<style>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms ease-out,
      transform 700ms ease-out;
  }
  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import "../scripts/tiltCards.js";
</script>

{/* El script de checkout de autoservicio se eliminó el 5-ago-2026 junto con
    el botón que lo disparaba. Apuntaba a Price IDs de sandbox, así que nunca
    pudo cobrar de verdad — y el modelo comercial nuevo pasa por SOW firmado,
    no por un botón. El worker `stripe-checkout` sigue desplegado pero el
    sitio ya no lo llama. */}
