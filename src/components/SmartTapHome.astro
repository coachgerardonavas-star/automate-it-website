---
/**
 * Sección "Smart Tap", aprobada por el CEO (ver
 * /workspace/website-automateit/smarttap-seccion/ESPEC_PARA_LINUS.md).
 * El copy es palabra por palabra el de fragmento.html — no editar el texto
 * visible.
 *
 * Va solo en la home en español, entre la franja "EL RESULTADO" + su ticker
 * y `#como-funciona` (ver Home2026.astro).
 *
 * La capa de Otoño (guirnalda, hojas, ramillete, calabaza/bellota) cuelga
 * de [data-season="otono"] en <html>, seteado por el script inline en
 * BaseLayout.astro. Sin ese atributo, `.st-fall` queda en `display:none` y
 * la sección se ve en su versión base — no hace falta ninguna condición acá
 * más allá de que el llamador la renderice solo con `lang === "es"`.
 */
---

<section class="st-home" id="smart-tap" aria-labelledby="smart-tap-titulo">
  <div class="st-fall st-garland" aria-hidden="true"></div>
  <img class="st-fall st-leaf st-l1" src="/assets/smart-tap/fall/hoja-arce.svg" alt="" aria-hidden="true" />
  <img class="st-fall st-leaf st-l2" src="/assets/smart-tap/fall/hoja-arce-ambar.svg" alt="" aria-hidden="true" />
  <img class="st-fall st-leaf st-l3" src="/assets/smart-tap/fall/hoja-roble.svg" alt="" aria-hidden="true" />
  <img class="st-fall st-leaf st-l4" src="/assets/smart-tap/fall/bellota.svg" alt="" aria-hidden="true" />
  <div class="st-inner">
    <div class="st-copy">
      <span class="st-tag">Smart Tap · tus datos</span>
      <h2 id="smart-tap-titulo">Conoce a <em>cada</em> cliente que <span class="mark">entra por tu puerta.</span></h2>
      <p class="st-sub">
        <b>Hoy tus clientes pagan y se van sin dejar rastro.</b> Con Smart Tap, cada visita te dice quién es, cada cuánto
        viene y cuánto te deja tu club. Con esos datos decides cómo vender más.
      </p>
      <ul class="st-list">
        <li>Quién viene y cada cuánto vuelve</li>
        <li>Su última visita</li>
        <li>Quién se te está yendo</li>
        <li>Lo que tu club te trajo</li>
      </ul>
      <div class="st-ctas">
        <a class="st-btn st-btn-primary" href="https://smarttap.yourbizupgraded.com/inicio"
          >Quiero conocer a mis clientes →</a
        >
        <a class="st-btn st-btn-secondary" href="https://smarttap.yourbizupgraded.com/inicio">Ver un panel de ejemplo</a
        >
      </div>
      <div class="st-seal">
        <span>Smart Tap · Powered by</span>
        <img src="/assets/logo-lockup.webp" alt="Automate IT" width="140" height="32" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="st-stage">
      <img
        class="st-logo"
        src="/assets/smart-tap/smart-tap-logo.webp"
        alt="Logo de Smart Tap"
        width="270"
        height="157"
        loading="lazy"
        decoding="async"
      />
      <div class="st-powered">
        <span>Powered by</span>
        <img
          src="/assets/logo-lockup.webp"
          alt="Automate IT"
          width="123"
          height="28"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="st-ejemplo">Ejemplo · Sabor Criollo</span>
      <div class="st-phone">
        <img class="st-fall st-sprig" src="/assets/smart-tap/fall/ramillete-otono.svg" alt="" aria-hidden="true" />
        <img
          class="st-screen"
          src="/assets/smart-tap/panel-ejemplo.webp"
          alt="Ejemplo del panel de Smart Tap en el celular del dueño: clientes que vuelven y clientes en el club"
          width="420"
          height="909"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="st-shot st-stats">
        <img
          src="/assets/smart-tap/stats-ejemplo.webp"
          alt="Ejemplo de datos de Smart Tap: clientes que vuelven en los últimos 30 días y clientes registrados en el club"
          width="489"
          height="114"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="st-fall st-harvest" aria-hidden="true">
        <img src="/assets/smart-tap/fall/calabaza.svg" alt="" width="62" height="52" />
        <img src="/assets/smart-tap/fall/bellota.svg" alt="" width="30" height="38" />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .st-home {
    --st-blue: #0052cc;
    --st-navy: #003da5;
    --st-ink: #0a0e1a;
    --st-muted: #3c4559;
    --st-yellow: #ffd45c;
    --st-warm: #e5242b;
    --st-gold: #d9a441;
    position: relative;
    overflow: hidden;
    font-family: "Open Sans", system-ui, sans-serif;
    color: var(--st-ink);
    padding: 104px 24px 104px;
    background:
      linear-gradient(rgba(0, 82, 204, 0.08) 1px, transparent 1px) 0 0/32px 32px,
      linear-gradient(90deg, rgba(0, 82, 204, 0.08) 1px, transparent 1px) 0 0/32px 32px,
      #eaf1fc;
  }
  .st-home * {
    box-sizing: border-box;
  }
  .st-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 56px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  /* --- escenario (banner navy donde vive el logo) --- */
  .st-stage {
    order: 1;
    position: relative;
    height: 600px;
    border-radius: 28px;
    background:
      radial-gradient(
        circle at 22% 17%,
        transparent 118px,
        rgba(217, 164, 65, 0.3) 119px,
        rgba(217, 164, 65, 0.3) 121px,
        transparent 122px,
        transparent 178px,
        rgba(217, 164, 65, 0.2) 179px,
        rgba(217, 164, 65, 0.2) 181px,
        transparent 182px,
        transparent 246px,
        rgba(217, 164, 65, 0.12) 247px,
        rgba(217, 164, 65, 0.12) 249px,
        transparent 250px,
        transparent 322px,
        rgba(217, 164, 65, 0.07) 323px,
        rgba(217, 164, 65, 0.07) 325px,
        transparent 326px
      ),
      radial-gradient(520px 380px at 20% 14%, rgba(217, 164, 65, 0.16), transparent 70%),
      linear-gradient(150deg, #0b0f1d 0%, #0d1a3d 48%, #003da5 100%);
    box-shadow:
      0 30px 70px rgba(0, 61, 165, 0.28),
      0 0 0 1.5px rgba(217, 164, 65, 0.45) inset;
  }
  .st-logo {
    position: absolute;
    left: 44px;
    top: 46px;
    width: 270px;
    height: auto;
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.45));
  }
  .st-powered {
    position: absolute;
    left: 52px;
    top: 214px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #c9d4ea;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .st-powered img {
    height: 28px;
    width: auto;
    background: #fff;
    border-radius: 8px;
    padding: 4px 8px;
  }
  .st-ejemplo {
    position: absolute;
    left: -14px;
    bottom: 166px;
    transform: rotate(-2deg);
    z-index: 6;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: var(--st-ink);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    padding: 8px 14px;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
    text-transform: uppercase;
  }
  .st-ejemplo::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--st-warm);
  }
  .st-phone {
    position: absolute;
    right: 36px;
    top: 44px;
    width: 228px;
    aspect-ratio: 420/909;
    border-radius: 40px;
    background: #111;
    padding: 10px;
    transform: rotate(3deg);
    z-index: 3;
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.45),
      0 0 0 2px #2a2d36 inset;
  }
  .st-phone > img.st-screen {
    width: 100%;
    height: 100%;
    border-radius: 31px;
    display: block;
    object-fit: cover;
  }
  .st-shot {
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
  }
  .st-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .st-stats {
    position: absolute;
    left: -28px;
    bottom: 58px;
    width: 400px;
    transform: rotate(-1.5deg);
    z-index: 4;
  }
  /* --- copy --- */
  .st-copy {
    order: 2;
  }
  .st-tag {
    display: inline-block;
    background: var(--st-navy);
    color: #fff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.16em;
    padding: 8px 14px;
    border-radius: 6px;
    text-transform: uppercase;
  }
  .st-home h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 800;
    font-size: 60px;
    line-height: 1.04;
    color: var(--st-ink);
    margin: 16px 0 18px;
    letter-spacing: -0.02em;
  }
  .st-home h2 em {
    font-style: italic;
    font-weight: 600;
    color: var(--st-blue);
  }
  .st-home h2 .mark {
    background: linear-gradient(transparent 62%, var(--st-yellow) 62%);
  }
  .st-sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--st-muted);
    max-width: 560px;
    margin: 0;
  }
  .st-sub b {
    color: var(--st-ink);
    font-weight: 600;
  }
  .st-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .st-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 600;
  }
  .st-list li::before {
    content: "✓";
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--st-blue);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 15px;
    font-weight: 700;
  }
  .st-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }
  .st-btn {
    font-weight: 600;
    font-size: 17px;
    border-radius: 999px;
    padding: 16px 28px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    white-space: nowrap;
  }
  .st-btn-primary {
    background: var(--st-blue);
    color: #fff;
    box-shadow: 0 10px 24px rgba(0, 82, 204, 0.3);
  }
  .st-btn-secondary {
    background: #fff;
    color: var(--st-navy);
    border: 2px solid var(--st-navy);
  }
  .st-btn:focus-visible {
    outline: 3px solid #ffd45c;
    outline-offset: 3px;
  }
  .st-seal {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    background: #fff;
    border: 1.5px solid #cfddf3;
    border-radius: 14px;
    padding: 10px 16px;
  }
  .st-seal span {
    font-size: 15px;
    font-weight: 600;
    color: var(--st-muted);
  }
  .st-seal img {
    height: 32px;
    width: auto;
    display: block;
  }
  /* --- capa Otoño (solo con data-season="otono") --- */
  .st-fall {
    display: none;
    position: absolute;
    pointer-events: none;
  }
  [data-season="otono"] .st-fall {
    display: block;
  }
  [data-season="otono"] .st-home {
    background:
      url(/assets/smart-tap/fall/patron-hojas-claro.svg) 0 0/300px 300px,
      radial-gradient(1100px 520px at 92% 0%, rgba(224, 160, 64, 0.22), transparent 60%),
      radial-gradient(700px 420px at 0% 100%, rgba(194, 87, 26, 0.09), transparent 65%),
      linear-gradient(rgba(0, 82, 204, 0.07) 1px, transparent 1px) 0 0/32px 32px,
      linear-gradient(90deg, rgba(0, 82, 204, 0.07) 1px, transparent 1px) 0 0/32px 32px,
      #eef1f8;
  }
  .st-garland {
    left: 0;
    right: 0;
    top: -6px;
    height: 46px;
    background: url(/assets/smart-tap/fall/guirnalda-hojas.svg) repeat-x 0 0/575px 46px;
    z-index: 3;
  }
  .st-leaf {
    z-index: 3;
  }
  .st-l1 {
    right: 40px;
    top: 58px;
    width: 44px;
    transform: rotate(18deg);
  }
  .st-l2 {
    right: 104px;
    top: 44px;
    width: 30px;
    transform: rotate(-24deg);
  }
  .st-l3 {
    right: 156px;
    top: 70px;
    width: 34px;
    transform: rotate(40deg);
  }
  .st-l4 {
    right: 212px;
    top: 50px;
    width: 22px;
    transform: rotate(-8deg);
    opacity: 0.9;
  }
  .st-phone img.st-sprig {
    left: 20%;
    top: -50px;
    width: 104px;
    height: auto;
    z-index: 7;
    transform: rotate(-5deg);
  }
  .st-harvest {
    right: -30px;
    bottom: -26px;
    z-index: 5;
    display: none;
    align-items: flex-end;
  }
  [data-season="otono"] .st-harvest {
    display: flex;
  }
  .st-harvest img {
    display: block;
  }
  /* --- móvil --- */
  @media (max-width: 760px) {
    .st-home {
      padding: 64px 20px 64px;
    }
    .st-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .st-stage {
      order: 1;
      height: auto;
      padding: 28px 20px 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px;
      background:
        radial-gradient(
          circle at 50% 70px,
          transparent 96px,
          rgba(217, 164, 65, 0.26) 97px,
          rgba(217, 164, 65, 0.26) 99px,
          transparent 100px,
          transparent 150px,
          rgba(217, 164, 65, 0.15) 151px,
          rgba(217, 164, 65, 0.15) 153px,
          transparent 154px
        ),
        radial-gradient(380px 260px at 50% 10%, rgba(217, 164, 65, 0.16), transparent 70%),
        linear-gradient(160deg, #0b0f1d 0%, #0d1a3d 50%, #003da5 100%);
    }
    .st-logo {
      position: relative;
      left: auto;
      top: auto;
      width: 210px;
    }
    .st-powered {
      position: relative;
      left: auto;
      top: auto;
      margin-top: -8px;
    }
    .st-ejemplo {
      position: relative;
      left: auto;
      top: auto;
      bottom: auto;
      transform: none;
      font-size: 12px;
    }
    .st-stats {
      display: none;
    }
    .st-seal {
      gap: 10px;
      padding: 10px 14px;
    }
    .st-seal span {
      font-size: 13px;
      white-space: nowrap;
    }
    .st-seal img {
      height: 28px;
    }
    .st-phone {
      position: relative;
      right: auto;
      top: auto;
      width: 190px;
      border-radius: 32px;
      padding: 8px;
      transform: rotate(2deg);
    }
    .st-phone > img.st-screen {
      border-radius: 25px;
    }
    .st-leaf,
    .st-sprig,
    [data-season="otono"] .st-harvest {
      display: none;
    }
    .st-copy {
      order: 2;
    }
    .st-home h2 {
      font-size: 42px;
    }
    .st-sub {
      font-size: 17px;
    }
    .st-list li {
      font-size: 17px;
    }
    .st-ctas {
      flex-direction: column;
      gap: 10px;
    }
    .st-btn {
      padding: 16px 20px;
    }
    .st-garland {
      height: 34px;
      background-size: 425px 34px;
      top: -4px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-season] * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
