---
/**
 * Gráfico de actividad diaria. SVG en línea, sin librería.
 *
 * Decisiones de lectura, no de gusto:
 * - Una sola serie ⇒ sin leyenda. El título ya la nombra; una caja de leyenda
 *   con un solo elemento es ruido.
 * - Un solo eje. Nunca dos escalas: si algún día hay que mostrar otra medida,
 *   va en su propio gráfico.
 * - Grilla y ejes recesivos; el trazo de datos es lo único con peso visual.
 * - Los números viven además en una tabla para lectores de pantalla, así que la
 *   información no depende de poder ver la curva.
 * - Capa de hover en CSS puro: cada columna es una zona sensible que muestra
 *   cruceta, punto y globo. Sin JavaScript.
 */
import { portalCopy, type PortalLang } from "../../lib/portal/copy";
import type { SeriesPoint } from "../../lib/portal/types";

interface Props {
  lang: PortalLang;
  points: SeriesPoint[];
  label: string;
}

const { lang, points, label } = Astro.props;
const copy = portalCopy(lang);

const W = 720;
const H = 240;
const PAD = { top: 16, right: 12, bottom: 28, left: 34 };

const values = points.map((p) => p.value);
const rawMax = Math.max(1, ...values);
// Techo redondeado hacia arriba: un eje que termina en 34 se lee peor que uno
// que termina en 40, y deja aire sobre el pico.
const step = rawMax <= 20 ? 5 : rawMax <= 50 ? 10 : 25;
const yMax = Math.ceil(rawMax / step) * step;

const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const x = (i: number) =>
  PAD.left + (points.length <= 1 ? plotW / 2 : (i / (points.length - 1)) * plotW);
const y = (v: number) => PAD.top + plotH - (v / yMax) * plotH;

const linePath = points.map((p, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(" ");
const areaPath = `${linePath} L${x(points.length - 1).toFixed(1)},${PAD.top + plotH} L${x(0).toFixed(1)},${PAD.top + plotH} Z`;

const ticks = Array.from({ length: 5 }, (_, i) => (yMax / 4) * i);

/** Cuatro etiquetas de fecha como mucho: más se pisan en teléfono. */
const labelIdx = points.length <= 4
  ? points.map((_, i) => i)
  : [0, Math.round((points.length - 1) / 3), Math.round(((points.length - 1) * 2) / 3), points.length - 1];

const locale = lang === "en" ? "en-US" : "es-ES";
const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(locale, { month: "short", day: "numeric" });

const uid = `chart-${Math.abs(points.length * 31 + Math.round(yMax)).toString(36)}`;
---

<figure class="m-0">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="activity-chart w-full"
    role="img"
    aria-labelledby={`${uid}-title`}
    preserveAspectRatio="xMidYMid meet"
  >
    <title id={`${uid}-title`}>{label}</title>

    <defs>
      <linearGradient id={`${uid}-fill`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-blue)" stop-opacity="0.18" />
        <stop offset="100%" stop-color="var(--color-blue)" stop-opacity="0.01" />
      </linearGradient>
    </defs>

    {/* Grilla horizontal: la referencia mínima para estimar una altura. */}
    {ticks.map((t) => (
      <g>
        <line
          x1={PAD.left} x2={W - PAD.right}
          y1={y(t)} y2={y(t)}
          stroke="var(--color-border)" stroke-width="1"
          shape-rendering="crispEdges"
        />
        <text
          x={PAD.left - 8} y={y(t) + 4}
          text-anchor="end"
          class="chart-tick"
        >{Math.round(t)}</text>
      </g>
    ))}

    <path d={areaPath} fill={`url(#${uid}-fill)`} />
    <path
      d={linePath}
      fill="none"
      stroke="var(--color-blue)"
      stroke-width="2"
      stroke-linejoin="round"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />

    {labelIdx.map((i) => (
      <text
        x={x(i)}
        y={H - 8}
        text-anchor={i === 0 ? "start" : i === points.length - 1 ? "end" : "middle"}
        class="chart-tick"
      >{fmtDate(points[i].date)}</text>
    ))}

    {/* Capa sensible. Una columna invisible por punto; al pasar por encima
        aparecen cruceta, punto y globo. El globo se ancla al inicio o al final
        cerca de los bordes para que no se salga del área. */}
    {points.map((p, i) => {
      const cx = x(i);
      const cy = y(p.value);
      const colW = plotW / Math.max(1, points.length - 1);
      const near = i < 3 ? "start" : i > points.length - 4 ? "end" : "middle";
      const tx = near === "start" ? cx + 6 : near === "end" ? cx - 6 : cx;
      return (
        <g class="chart-pt">
          <rect
            x={cx - colW / 2} y={PAD.top}
            width={colW} height={plotH}
            fill="transparent"
          />
          <line
            x1={cx} x2={cx} y1={PAD.top} y2={PAD.top + plotH}
            stroke="var(--color-border-strong)" stroke-width="1"
            class="chart-cross"
          />
          <circle
            cx={cx} cy={cy} r="4.5"
            fill="var(--color-blue)" stroke="#fff" stroke-width="2"
            class="chart-dot"
          />
          <g class="chart-tip" transform={`translate(${tx}, ${Math.max(PAD.top + 26, cy - 12)})`}>
            <rect
              x={near === "start" ? 0 : near === "end" ? -128 : -64}
              y="-34" width="128" height="34" rx="6"
              fill="#fff" stroke="var(--color-border)"
            />
            <text
              x={near === "start" ? 10 : near === "end" ? -118 : -54}
              y="-20" class="chart-tip-date"
            >{fmtDate(p.date)}</text>
            <text
              x={near === "start" ? 10 : near === "end" ? -118 : -54}
              y="-7" class="chart-tip-value"
            >{p.value} {label.toLowerCase()}</text>
          </g>
        </g>
      );
    })}
  </svg>

  {/* Los mismos datos en tabla. No es un extra: es lo que hace que el gráfico
      no sea la única forma de acceder a la información. */}
  <figcaption class="sr-only">
    <table>
      <caption>{label}</caption>
      <thead>
        <tr><th scope="col">{copy.range.label}</th><th scope="col">{label}</th></tr>
      </thead>
      <tbody>
        {points.map((p) => (
          <tr><th scope="row">{fmtDate(p.date)}</th><td>{p.value}</td></tr>
        ))}
      </tbody>
    </table>
  </figcaption>
</figure>

<style>
  .activity-chart {
    height: 200px;
  }
  @media (min-width: 640px) {
    .activity-chart {
      height: 260px;
    }
  }

  .chart-tick {
    font-size: 11px;
    fill: var(--color-text-subtle);
    font-family: inherit;
  }

  /* Cruceta, punto y globo apagados hasta que el puntero entra en la columna. */
  .chart-cross,
  .chart-dot,
  .chart-tip {
    opacity: 0;
    transition: opacity 120ms var(--ease-brand);
    pointer-events: none;
  }
  .chart-pt:hover .chart-cross,
  .chart-pt:hover .chart-dot,
  .chart-pt:hover .chart-tip {
    opacity: 1;
  }

  .chart-tip-date {
    font-size: 11px;
    fill: var(--color-text-muted);
  }
  .chart-tip-value {
    font-size: 12px;
    font-weight: 600;
    fill: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .chart-cross,
    .chart-dot,
    .chart-tip {
      transition: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
