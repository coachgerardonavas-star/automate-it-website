---
/**
 * Barra lateral del portal.
 *
 * En escritorio es parte del layout. En teléfono es un drawer que entra desde
 * la izquierda, controlado por el script de `PortalLayout`. El mismo marcado
 * sirve para los dos casos: cambia el posicionamiento, no la estructura, para
 * que no haya dos navegaciones que mantener en paralelo.
 */
import { portalCopy, type PortalLang } from "../../lib/portal/copy";
import { PORTAL_BASE, type NavItem } from "../../lib/portal/config";
import type { Organization } from "../../lib/portal/types";
import PortalIcon from "./PortalIcon.astro";

interface Props {
  lang: PortalLang;
  items: NavItem[];
  currentPath: string;
  activeOrg: Organization | null;
}

const { lang, items, currentPath, activeOrg } = Astro.props;
const copy = portalCopy(lang);

/**
 * Marca activo el enlace actual.
 *
 * El Resumen vive en la raíz del portal, así que un `startsWith` lo dejaría
 * encendido en todas las pantallas. Por eso se compara exacto para esa ruta y
 * por prefijo para el resto.
 */
function isActive(href: string): boolean {
  const path = currentPath.replace(/\/$/, "") || PORTAL_BASE;
  if (href === PORTAL_BASE) return path === PORTAL_BASE;
  return path === href || path.startsWith(`${href}/`);
}

const nav = (copy.nav as unknown) as Record<string, string>;
---

<aside class="portal-sidebar" aria-label={copy.nav.openMenu}>
  <div class="flex items-center justify-between gap-2 px-5 h-16 shrink-0">
    <a
      href={PORTAL_BASE}
      class="flex items-center gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-blue)]"
    >
      <span class="font-heading text-lg tracking-tight text-[var(--color-text-primary)]">
        AUTOMATE <span class="text-[var(--color-blue)]">IT</span>
      </span>
    </a>
    {/* Cerrar: solo se ve en teléfono, donde la barra tapa el contenido. */}
    <button
      type="button"
      data-drawer-close
      class="lg:hidden -mr-2 p-2 rounded-sm text-[var(--color-text-muted)] hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-blue)]"
      aria-label={copy.nav.closeMenu}
    >
      <PortalIcon name="x" size={20} />
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 pb-4">
    <ul class="space-y-0.5">
      {items.map((item) => {
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-md px-3 py-2.5 text-sm transition-colors duration-200 ease-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-blue)]",
                active
                  ? "bg-[var(--color-info-bg)] text-[var(--color-blue)] font-semibold"
                  : "text-[var(--color-text-secondary)] hover:bg-neutral-100",
              ]}
            >
              <PortalIcon
                name={item.icon}
                size={20}
                class={active ? "text-[var(--color-blue)] shrink-0" : "text-[var(--color-text-muted)] shrink-0"}
              />
              <span class="truncate">{nav[item.key] ?? item.key}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  {/* Bloque de soporte: el portal debe recordar que Automate IT sigue ahí
      después de instalar (handoff §20). */}
  <div class="px-3 pb-4 shrink-0">
    <div class="rounded-lg border border-[var(--color-border)] bg-neutral-50 p-4">
      <p class="text-sm font-semibold text-[var(--color-text-primary)]">
        {copy.support.title}
      </p>
      <p class="mt-1 text-xs text-[var(--color-text-muted)] leading-relaxed">
        {copy.support.body}
      </p>
      <a
        href="mailto:automateit@yourbizupgraded.com"
        class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-sm bg-[var(--color-blue)] px-3 py-2 text-xs font-semibold text-white transition-colors duration-200 ease-brand hover:bg-[var(--color-navy)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-blue)]"
      >
        <PortalIcon name="circle-help" size={16} />
        {copy.support.cta}
      </a>
      {activeOrg?.accountManager && (
        <p class="mt-3 border-t border-[var(--color-border)] pt-3 text-xs text-[var(--color-text-muted)]">
          {copy.support.managerLabel}:
          <span class="block font-semibold text-[var(--color-text-secondary)]">
            {activeOrg.accountManager}
          </span>
        </p>
      )}
    </div>
  </div>
</aside>

<style>
  .portal-sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 50;
    width: 17rem;
    max-width: 85vw;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-inline-end: 1px solid var(--color-border);
    transform: translateX(-100%);
    transition: transform 240ms var(--ease-brand);
  }

  :global(.portal-root[data-open="true"]) .portal-sidebar {
    transform: translateX(0);
  }

  @media (min-width: 1024px) {
    .portal-sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      transform: none;
      width: 16rem;
      max-width: none;
      flex-shrink: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal-sidebar {
      transition: none;
    }
  }
</style>
