---
import "../styles/global.css";
import { translations, type Lang } from "../i18n/translations";
import { jsonLd } from "../lib/jsonld";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import {
  GA_ID,
  SEARCH_CONSOLE_VERIFICATION,
  isGAEnabled,
  isSearchConsoleEnabled,
} from "../config/site";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
  chatbot?: boolean;
}

const {
  lang = "es",
  title,
  description,
  noindex = false,
  chatbot = true,
} = Astro.props;
const t = translations[lang];
const pageTitle = title ?? t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const ogLocale = lang === "en" ? "en_US" : "es_MX";
const htmlLang = lang === "en" ? "en" : "es";
const enableGA = isGAEnabled();
const enableSC = isSearchConsoleEnabled();
const canonicalUrl = Astro.url.href;
// Lockup sobre fondo blanco sólido: las redes sociales componen la imagen de
// Open Graph sobre fondos impredecibles, así que aquí no sirve transparencia.
const ogImageUrl = "https://yourbizupgraded.com/assets/logo-og.png";

// ProfessionalService es subtipo de LocalBusiness: es lo que permite declarar
// NAP (nombre, dirección, teléfono) y que Google entienda que hay una empresa
// real detrás del dominio. Sin esto, "Automate IT" y yourbizupgraded.com son
// dos entidades sin relación para un buscador.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://yourbizupgraded.com/#organization",
  name: "Automate IT",
  legalName: "Automate IT LLC",
  alternateName: ["Automate IT LLC", "Your Biz Upgraded"],
  url: "https://yourbizupgraded.com",
  logo: ogImageUrl,
  image: ogImageUrl,
  description: pageDescription,
  email: "automateit@yourbizupgraded.com",
  telephone: "+1-407-214-5114",
  // Negocio de área de servicio: se declara la ciudad sede sin dirección de
  // calle, que es el patrón que Google espera cuando no hay local al público.
  address: {
    "@type": "PostalAddress",
    addressLocality: "Orlando",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Orlando" },
    { "@type": "State", name: "Florida" },
    { "@type": "Country", name: "United States" },
  ],
  serviceType: [
    "Business Process Improvement",
    "Systems Integration",
    "Workflow Automation",
    "Operational Dashboards",
  ],
  // sameAs es el campo por el que un buscador confirma que estos perfiles y
  // este dominio son la misma entidad. Agregar aquí LinkedIn y el perfil de
  // Google Business en cuanto existan.
  sameAs: ["https://www.instagram.com/automateit.usa/"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Automate IT",
  url: "https://yourbizupgraded.com",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://yourbizupgraded.com/?s={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {
      enableSC && (
        <meta
          name="google-site-verification"
          content={SEARCH_CONSOLE_VERIFICATION}
        />
      )
    }
    <meta name="theme-color" content="#FFFFFF" />
    {/* Una página noindex no participa en la indexación, así que no tiene
    canonical que reclamar: emitirlo manda dos señales que se contradicen. og:url
    sí se mantiene abajo, porque las redes lo usan al compartir el enlace. */}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Automate IT" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link
      rel="alternate"
      hreflang="es"
      href={new URL("/", Astro.site).toString()}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL("/en/", Astro.site).toString()}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.site).toString()}
    />

    {
      enableGA && (
        <script is:inline define:vars={{ GA_ID }}>
          // GA4 en dos tiempos, a propósito:
          //
          //   1. La COLA (`dataLayer` + `gtag`) se arma AQUÍ MISMO, síncrona.
          //      gtag.js no hace falta para encolar: cualquier gtag(...) que
          //      se llame antes de que cargue la librería queda guardado y se
          //      procesa cuando llega. Armarla ya es lo que permite que un
          //      evento de conversión dispare desde el primer instante.
          //   2. La LIBRERÍA (~160KB) se difiere ~2s tras window.load para
          //      mantenerla fuera del camino crítico de LCP/TBT. El page_view
          //      sale cuando se procesa la cola, así que el diferido no pierde
          //      la visita, solo la reporta un momento después.
          //
          // NOTE: script body must be plain JS — wrapping it in a {`...`} JSX
          // template literal renders the GA loader as a string inside a block
          // statement and it never executes.
          (function(){
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', GA_ID, { anonymize_ip: true });

            var requested = false;
            function loadGA(){
              if (requested) return;
              requested = true;
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
              document.head.appendChild(s);
            }
            if (document.readyState === 'complete') {
              setTimeout(loadGA, 2000);
            } else {
              window.addEventListener('load', function(){ setTimeout(loadGA, 2000); });
            }

            // Único punto de envío de eventos de conversión del sitio.
            //
            // - Adelanta la carga de gtag.js: una interacción NO espera los 2s
            //   del page_view. Quien envía un formulario puede cerrar la
            //   pestaña enseguida, y un evento encolado sin librería no sale.
            // - Deduplica por nombre dentro de la misma carga de página: si el
            //   worker falla y la persona reintenta, la conversión cuenta una
            //   sola vez. Recargar la página sí permite contar de nuevo.
            // - Agrega `page_lang` a todo, que es lo que permite separar el
            //   embudo en español del de inglés en los informes.
            //
            // Los llamadores DEBEN invocarla como `window.trackEvent?.(...)`:
            // cuando GA está apagado (isGAEnabled() === false) este bloque no
            // se emite y la función no existe.
            var sent = {};
            window.trackEvent = function(name, params){
              if (sent[name]) return;
              sent[name] = true;
              loadGA();
              var payload = { page_lang: document.documentElement.lang || 'es' };
              for (var k in (params || {})) payload[k] = params[k];
              gtag('event', name, payload);
            };
          })();
        </script>
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(organizationSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(websiteSchema)}
    />

    <title>{pageTitle}</title>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text-primary)]">
    <slot />
    {chatbot && <WhatsAppButton lang={lang} />}
  </body>
</html>
