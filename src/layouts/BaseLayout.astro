---
import "../styles/global.css";
import { translations, type Lang } from "../i18n/translations";
import { jsonLd } from "../lib/jsonld";
import ChatbotWidget from "../components/ChatbotWidget.astro";
import {
  GA_ID,
  SEARCH_CONSOLE_VERIFICATION,
  isGAEnabled,
  isSearchConsoleEnabled,
} from "../config/site";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
  chatbot?: boolean;
}

const {
  lang = "es",
  title,
  description,
  noindex = false,
  chatbot = true,
} = Astro.props;
const t = translations[lang];
const pageTitle = title ?? t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const ogLocale = lang === "en" ? "en_US" : "es_MX";
const htmlLang = lang === "en" ? "en" : "es";
const enableGA = isGAEnabled();
const enableSC = isSearchConsoleEnabled();
const canonicalUrl = Astro.url.href;
// Lockup sobre fondo blanco sólido: las redes sociales componen la imagen de
// Open Graph sobre fondos impredecibles, así que aquí no sirve transparencia.
const ogImageUrl = "https://yourbizupgraded.com/assets/logo-og.png";

// ProfessionalService es subtipo de LocalBusiness: es lo que permite declarar
// NAP (nombre, dirección, teléfono) y que Google entienda que hay una empresa
// real detrás del dominio. Sin esto, "Automate IT" y yourbizupgraded.com son
// dos entidades sin relación para un buscador.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://yourbizupgraded.com/#organization",
  name: "Automate IT",
  legalName: "Automate IT LLC",
  alternateName: ["Automate IT LLC", "Your Biz Upgraded"],
  url: "https://yourbizupgraded.com",
  logo: ogImageUrl,
  image: ogImageUrl,
  description:
    "Miembros digitales para pequeños negocios. Agentes de voz, chatbots de WhatsApp y CRM automatizado, conectados a las herramientas que ya usas.",
  email: "automateit@yourbizupgraded.com",
  telephone: "+1-407-214-5114",
  // Negocio de área de servicio: se declara la ciudad sede sin dirección de
  // calle, que es el patrón que Google espera cuando no hay local al público.
  address: {
    "@type": "PostalAddress",
    addressLocality: "Orlando",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: [
    { "@type": "City", name: "Orlando" },
    { "@type": "State", name: "Florida" },
    { "@type": "Country", name: "United States" },
  ],
  serviceType: [
    "AI Voice Agent",
    "WhatsApp Chatbot",
    "CRM Automation",
    "Business Process Automation",
  ],
  // sameAs es el campo por el que un buscador confirma que estos perfiles y
  // este dominio son la misma entidad. Agregar aquí LinkedIn y el perfil de
  // Google Business en cuanto existan.
  sameAs: ["https://www.instagram.com/automateit.usa/"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Automate IT",
  url: "https://yourbizupgraded.com",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://yourbizupgraded.com/?s={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {
      enableSC && (
        <meta
          name="google-site-verification"
          content={SEARCH_CONSOLE_VERIFICATION}
        />
      )
    }
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Automate IT" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manifold-cf-extrabold.woff2"
      crossorigin="anonymous"
    />

    <link
      rel="alternate"
      hreflang="es"
      href={new URL("/", Astro.site).toString()}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL("/en/", Astro.site).toString()}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.site).toString()}
    />

    {
      enableGA && (
        <script is:inline define:vars={{ GA_ID }}>
          // Defer GA4 ~2s after window.load to keep gtag.js (~160KB) out of
          // the LCP / TBT critical path while still firing in time to track
          // the visit. NOTE: script body must be plain JS — wrapping it in a
          // {`...`} JSX template literal renders the GA loader as a string
          // inside a block statement and it never executes.
          (function(){
            function loadGA(){
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              window.gtag = gtag;
              gtag('js', new Date());
              gtag('config', GA_ID, { anonymize_ip: true });
            }
            if (document.readyState === 'complete') {
              setTimeout(loadGA, 2000);
            } else {
              window.addEventListener('load', function(){ setTimeout(loadGA, 2000); });
            }
          })();
        </script>
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(organizationSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLd(websiteSchema)}
    />

    <title>{pageTitle}</title>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text-primary)]">
    <slot />
    {chatbot && <ChatbotWidget lang={lang} />}
  </body>
</html>
