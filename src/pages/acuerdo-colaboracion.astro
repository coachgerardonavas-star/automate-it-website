---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const lang = "es" as const;

/**
 * Versión del texto aceptado. Si cambias UNA palabra del acuerdo de abajo,
 * sube esta versión: lo que queda firmado es un texto concreto, y sin este
 * dato no se puede demostrar cuál.
 */
const VERSION = "v1 · 31-jul-2026";
const WORKER = "https://consultoria-intake.coachgerardonavas.workers.dev/acuerdo";

const nosotros = [
  ["Trabajo real, no una muestra", "Ejecutamos los entregables acordados en tu plan de trabajo, con el mismo estándar que aplicamos a un cliente que paga."],
  ["Dos rondas de revisión por entregable", "En cada ronda puedes pedir todos los cambios que quieras, presentados de una vez."],
  ["Todo es tuyo", "Los entregables y los archivos quedan a tu nombre. Si mañana dejamos de trabajar juntos, te los llevas."],
];

const ellos = [
  ["Acceso a tus números, al inicio y al final", "Capturas de tus métricas —alcance, seguidores, clics o ventas— cuando arrancamos y cuando cerramos."],
  ["Un testimonio en video de 2 a 3 minutos", "Grabado con tu celular, sin producción. Al cierre de la colaboración."],
  ["Una reseña en Google", "Cuando veas el primer resultado, no antes."],
  ["Dos presentaciones", "A dos personas de tu entorno que también necesiten esto. Una presentación, no una venta."],
  ["Una mención y dos historias por cada cuatro semanas", "Una publicación o reel donde nos menciones, más dos historias. Tú decides el formato y las palabras."],
];

const input =
  "w-full px-4 py-3 rounded bg-[var(--color-bg-soft)] border border-[var(--color-border)] text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-blue)] transition-colors";
const label = "block text-sm font-semibold text-[var(--color-text-primary)] mb-2";
---

<BaseLayout
  lang={lang}
  title="Acuerdo de Colaboración · Automate IT"
  description="Acuerdo de colaboración entre Automate IT LLC y creadores."
  noindex={true}
  chatbot={false}
>
  <Nav lang={lang} />
  <main>
    <section class="py-16 sm:py-24">
      <div class="max-w-2xl mx-auto px-5 lg:px-8">
        <p class="font-sans text-[11px] tracking-[0.28em] uppercase text-[var(--color-blue)] mb-5 font-semibold">
          Programa de colaboración con creadores
        </p>
        <h1 class="font-heading text-3xl sm:text-5xl leading-tight mb-5">
          Acuerdo de Colaboración
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed mb-3">
          Esto no es un servicio gratis ni un favor. Es un intercambio: nosotros ponemos
          el trabajo, tú pones la visibilidad y la prueba de que funcionó.
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mb-12">Versión {VERSION}</p>

        <h2 class="font-heading text-2xl mb-4">Lo que hacemos nosotros</h2>
        <ul class="space-y-4 mb-12">
          {nosotros.map(([t, d]) => (
            <li>
              <p class="font-semibold text-[var(--color-text-primary)]">{t}</p>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{d}</p>
            </li>
          ))}
        </ul>

        <h2 class="font-heading text-2xl mb-2">Lo que pedimos a cambio</h2>
        <p class="text-sm text-[var(--color-text-secondary)] mb-4">
          En orden de importancia. El primero es el que de verdad necesitamos; el último
          es el más visible pero el menos decisivo.
        </p>
        <ol class="space-y-4 mb-6">
          {ellos.map(([t, d], i) => (
            <li class="flex gap-3">
              <span class="flex-none w-6 h-6 rounded-full bg-[var(--color-blue)] text-white text-xs font-bold flex items-center justify-center mt-0.5">
                {i + 1}
              </span>
              <span>
                <span class="block font-semibold text-[var(--color-text-primary)]">{t}</span>
                <span class="block text-sm text-[var(--color-text-secondary)] leading-relaxed">{d}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-12 border-l-2 border-brand-lime pl-5">
          Nada de esto se pide el primer día. Los números al arrancar; la reseña cuando
          veas un resultado; el testimonio y las presentaciones al cerrar. Si al final
          sientes que el trabajo no lo merece, dínoslo — preferimos eso a un testimonio
          de compromiso.
        </p>

        <h2 class="font-heading text-2xl mb-4">Uso del proceso como material</h2>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-3">
          Autorizas que usemos en nuestros materiales de marketing tu nombre y tu cuenta,
          capturas de tu perfil y de los entregables, los resultados obtenidos, y los
          comentarios que nos hagas llegar durante el trabajo.
        </p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-12">
          Puedes revocar esta autorización cuando quieras escribiendo a
          automateit@yourbizupgraded.com. Lo ya publicado puede permanecer; después de
          la revocación no publicamos nada nuevo.
        </p>

        <h2 class="font-heading text-2xl mb-4">Duración y salida</h2>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-12">
          Cubre cuatro semanas de trabajo desde la firma, según el plan que se entrega
          por separado. Cualquiera de las dos partes puede terminarlo avisando por
          escrito: si terminas antes de que entreguemos, no debes nada de lo anterior;
          si terminamos nosotros, lo ya entregado sigue siendo tuyo. Ninguna parte
          adquiere participación en el negocio de la otra, y cada una responde por sus
          propias obligaciones fiscales.
        </p>

        <div class="border-t border-[var(--color-border)] pt-10">
          <h2 class="font-heading text-2xl mb-6">Firma</h2>

          <form id="firma-form" class="space-y-6" novalidate data-worker={WORKER} data-version={VERSION}>
            <label class="block">
              <span class={label}>Tu nombre completo</span>
              <input type="text" name="nombre" required autocomplete="name" class={input} />
            </label>

            <label class="block">
              <span class={label}>Email</span>
              <input type="email" name="email" required autocomplete="email" class={input} />
            </label>

            <label class="block">
              <span class={label}>Tu cuenta principal</span>
              <input type="text" name="cuenta" required placeholder="@tucuenta" class={input} />
            </label>

            <div class="space-y-4 pt-2">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="acepta" required class="mt-1 w-4 h-4 accent-[var(--color-blue)]" />
                <span class="text-sm text-[var(--color-text-primary)]">
                  He leído y acepto este acuerdo completo, versión {VERSION}.
                </span>
              </label>
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="aceptaFtc" required class="mt-1 w-4 h-4 accent-[var(--color-blue)]" />
                <span class="text-sm text-[var(--color-text-primary)]">
                  Me comprometo a declarar públicamente la colaboración cuando los mencione,
                  como exige la FTC.
                </span>
              </label>
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="aceptaElectronica" required class="mt-1 w-4 h-4 accent-[var(--color-blue)]" />
                <span class="text-sm text-[var(--color-text-primary)]">
                  Acepto firmar este acuerdo de forma electrónica y que esta firma tenga
                  la misma validez que una manuscrita.
                </span>
              </label>
            </div>

            <label class="block pt-2">
              <span class={label}>Escribe tu nombre completo para firmar</span>
              <input type="text" name="firma" required autocomplete="off" class={`${input} font-heading text-xl`} />
              <span class="block text-xs text-[var(--color-text-muted)] mt-2">
                Debe coincidir exactamente con el nombre de arriba. Se registran la fecha,
                la hora y tu dirección IP como constancia.
              </span>
            </label>

            <div class="pt-2">
              <button
                type="submit"
                class="btn-cta w-full inline-flex items-center justify-center px-6 py-3 rounded-sm font-semibold bg-[var(--color-blue)] text-white hover:bg-[var(--color-navy)] disabled:opacity-50 transition-colors"
              >
                Firmar el acuerdo
              </button>
            </div>
          </form>

          <p id="firma-error" class="hidden text-sm text-[var(--color-danger)] mt-4" role="alert"></p>

          <div id="firma-ok" class="hidden p-8 rounded-lg border border-brand-lime/40 bg-brand-lime/5" role="status" aria-live="polite">
            <p class="font-heading text-2xl mb-3 text-brand-lime">Acuerdo firmado.</p>
            <p class="text-base text-[var(--color-text-primary)] leading-relaxed mb-4">
              Quedó registrado con fecha y hora. Guarda tu copia — es tuya y conviene que
              la tengas.
            </p>
            <a
              href="/guias/acuerdo-de-colaboracion.pdf"
              class="inline-flex items-center px-5 py-2.5 rounded-sm font-semibold bg-[var(--color-blue)] text-white hover:bg-[var(--color-navy)] transition-colors"
            >
              Descargar mi copia en PDF
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<script>
  const form = document.getElementById("firma-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("firma-error");
  const okEl = document.getElementById("firma-ok");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !errorEl || !okEl) return;

    errorEl.classList.add("hidden");
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const fd = new FormData(form);
    const nombre = String(fd.get("nombre") ?? "").trim();
    const firma = String(fd.get("firma") ?? "").trim();

    // Se valida aquí y también en el servidor: aquí para explicarlo bien,
    // allá porque es lo único que no se puede saltar.
    if (nombre.toLowerCase() !== firma.toLowerCase()) {
      errorEl.textContent =
        "La firma debe coincidir exactamente con tu nombre completo.";
      errorEl.classList.remove("hidden");
      return;
    }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Registrando…";
    }

    try {
      const res = await fetch(form.dataset.worker ?? "", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nombre,
          firma,
          email: String(fd.get("email") ?? "").trim(),
          cuenta: String(fd.get("cuenta") ?? "").trim(),
          acepta: fd.get("acepta") !== null,
          aceptaFtc: fd.get("aceptaFtc") !== null,
          aceptaElectronica: fd.get("aceptaElectronica") !== null,
          version: form.dataset.version,
        }),
      });
      if (!res.ok) {
        const body = (await res.json().catch(() => ({}))) as { error?: string };
        throw new Error(body.error ?? `HTTP ${res.status}`);
      }
      form.classList.add("hidden");
      okEl.classList.remove("hidden");
      okEl.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (err) {
      console.error("[acuerdo] firma:", err);
      errorEl.textContent =
        "No pudimos registrar tu firma. Intenta de nuevo, o escríbenos a automateit@yourbizupgraded.com.";
      errorEl.classList.remove("hidden");
      if (btn) {
        btn.disabled = false;
        btn.textContent = "Firmar el acuerdo";
      }
    }
  });
</script>
