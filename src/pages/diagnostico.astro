---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import DiagnosticoForm from "../components/DiagnosticoForm.astro";
const lang = "es" as const;
---

<BaseLayout lang={lang} title="Diagnóstico gratuito · Automate IT">
  <Nav lang={lang} />
  <main class="min-h-[60vh] pt-10 pb-24">
    <div class="max-w-2xl mx-auto px-5 lg:px-8">
      <a href="/" class="inline-block text-sm text-[var(--color-text-muted)] hover:text-[var(--color-navy)] transition-colors mb-8">← Volver a la home</a>
      <header class="mb-8">
        <h1 class="font-heading text-3xl sm:text-5xl leading-tight mb-4">Diagnóstico gratuito de tu operación</h1>
        <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed">Cuéntanos cómo funciona hoy tu negocio y qué se complica cuando aumenta el trabajo. No necesitas saber qué automatizar: esa parte empieza después de entender el proceso.</p>
      </header>
      <div class="mb-8 flex flex-col sm:flex-row gap-4 text-sm text-[var(--color-text-muted)]">
        <span>— Sin costo.</span>
        <span>— Sin venta agresiva.</span>
        <span>— Primero entendemos; después decidimos si vale la pena intervenir.</span>
      </div>
      <DiagnosticoForm lang={lang} />
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
