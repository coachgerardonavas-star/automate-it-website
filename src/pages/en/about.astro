---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const lang = "en" as const;

// NAP (name, address, phone). Must match the BaseLayout schema, the footer and
// the Google Business Profile character for character. Change one, change all.
const nap = {
  legalName: "Automate IT LLC",
  locality: "Orlando, Florida, United States",
  phoneHref: "+14072145114",
  phonePretty: "(407) 214-5114",
  email: "automateit@yourbizupgraded.com",
  sunbizDoc: "L26000247785",
};

const howWeWork = [
  {
    heading: "Map how work runs today",
    body: "We look at how work comes in, how it moves, who is involved, which tools the team uses, and where delays, errors, or key-person dependencies show up.",
  },
  {
    heading: "Prioritize what matters most",
    body: "We look for where time, information, or money is being lost and start with the point that has enough impact to justify a change.",
  },
  {
    heading: "Build the right improvement",
    body: "We may simplify a process, remove steps, create a form, fix part of the website, organize data, connect tools, add a control, or automate a specific task. The cause guides the choice.",
  },
  {
    heading: "Measure the result",
    body: "Before we close the work, we define what should change in the operation. Then we review the result and adjust what needs attention.",
  },
];
---

<BaseLayout
  lang={lang}
  title="About us — Automate IT LLC · Orlando, Florida"
  description="We help small and midsize business owners find where their operation is losing time, information, or money and build a measurable improvement."
>
  <Nav lang={lang} />
  <main>
    <section class="bg-[#050A18] text-white py-16 sm:py-24">
      <div class="max-w-3xl mx-auto px-5 lg:px-8">
        <a
          href="/en/"
          class="inline-flex items-center gap-2 text-xs sm:text-sm text-white/55 hover:text-brand-cyan transition-colors mb-10"
        >
          ← Back to home
        </a>

        <header class="mb-12">
          <p
            class="text-[11px] tracking-[0.22em] uppercase text-brand-cyan font-semibold mb-4"
          >
            About us
          </p>
          <h1
            class="font-heading text-3xl sm:text-5xl leading-tight mb-5 text-white"
          >
            We step into the operation to understand what is slowing it down.
          </h1>
          <p class="text-base sm:text-lg text-white/75 leading-relaxed">
            We are {nap.legalName}, a Florida-registered company. We work with
            small and midsize business owners to understand how work moves,
            find where it gets stuck, and improve what is worth changing.
          </p>
        </header>

        <section class="mb-14">
          <h2 class="font-heading text-2xl sm:text-3xl mb-4 text-white">
            The problem we look for
          </h2>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed mb-4">
            As a business grows, someone still has to remember tasks, move
            information by hand, wait for the owner to approve the next step,
            keep track of customers, and hold together processes that work
            because one person knows what to do.
          </p>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed">
            We review that flow to find the cause of the friction. The right
            change may be a better process, a connection between two tools, a
            control, a website fix, or automation for one specific step. In
            some cases, the best decision is to leave a working part alone.
          </p>
        </section>

        <section class="mb-14">
          <h2 class="font-heading text-2xl sm:text-3xl mb-6 text-white">
            How we work
          </h2>
          <div class="space-y-7">
            {
              howWeWork.map((item) => (
                <div>
                  <h3 class="font-heading text-lg sm:text-xl mb-2 text-white">
                    {item.heading}
                  </h3>
                  <p class="text-sm sm:text-base text-white/75 leading-relaxed">
                    {item.body}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <section class="mb-14">
          <h2 class="font-heading text-2xl sm:text-3xl mb-4 text-white">
            Where we are
          </h2>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed">
            We are based in Orlando, Florida. We can work remotely with
            businesses outside the state when the diagnostic and the type of
            work allow it. Florida remains our home market and the place where
            we can observe an operation in person when needed.
          </p>
        </section>

        <section
          class="rounded-xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 mb-12"
        >
          <h2 class="font-heading text-xl sm:text-2xl mb-5 text-white">
            Company details
          </h2>
          <dl class="space-y-4 text-sm sm:text-base">
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Legal name</dt>
              <dd class="text-white/90">{nap.legalName}</dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">State registration</dt>
              <dd class="text-white/90">
                Florida · Document {nap.sunbizDoc}
                <span class="block text-xs text-white/45 mt-1">
                  Verifiable in the public records of the Florida Division of
                  Corporations (sunbiz.org).
                </span>
              </dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Location</dt>
              <dd class="text-white/90">{nap.locality}</dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Phone</dt>
              <dd>
                <a
                  href={`tel:${nap.phoneHref}`}
                  class="text-white/90 hover:text-brand-cyan transition-colors"
                >
                  {nap.phonePretty}
                </a>
              </dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Email</dt>
              <dd>
                <a
                  href={`mailto:${nap.email}`}
                  class="text-white/90 hover:text-brand-cyan transition-colors break-all"
                >
                  {nap.email}
                </a>
              </dd>
            </div>
          </dl>
        </section>

        <div
          class="rounded-xl border border-brand-cyan/25 bg-brand-cyan/[0.06] p-6 sm:p-8"
        >
          <h2 class="font-heading text-xl sm:text-2xl mb-3 text-white">
            Want to see where your time is going?
          </h2>
          <p class="text-sm sm:text-base text-white/75 leading-relaxed mb-6">
            The diagnostic takes about five minutes. Your answers give us the
            starting point for your Operation X-Ray and help us decide what is
            worth reviewing first.
          </p>
          <a
            href="/en/diagnostic"
            class="inline-flex items-center justify-center rounded-lg bg-brand-cyan px-6 py-3 font-semibold text-[#050A18] hover:bg-white transition-colors"
          >
            Request a free diagnostic
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
