---
/**
 * /en/demo — destino de la tarjeta NFC.
 *
 * `noindex`: es material de visita en persona, no una página para buscadores.
 * Sin Nav ni botón flotante de WhatsApp: es una pantalla completa que pide
 * nombre y negocio y abre la demo; ya trae su propia salida a WhatsApp.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import DemoEntrada from "../../components/DemoEntrada.astro";
import { translations } from "../../i18n/translations";

const lang = "en" as const;
const t = translations[lang].demoEntrada;
---

<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  noindex={true}
  chatbot={false}
>
  <DemoEntrada lang={lang} />
</BaseLayout>
