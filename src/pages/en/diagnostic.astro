---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import DiagnosticoForm from "../../components/DiagnosticoForm.astro";
const lang = "en" as const;
---

<BaseLayout
  lang={lang}
  title="Free operations diagnostic · Automate IT"
  description="Tell us how your business works today. We review where work gets stuck, what impact it has, and which change is worth evaluating first."
>
  <Nav lang={lang} />
  <main class="min-h-[60vh] pt-10 pb-24">
    <div class="max-w-2xl mx-auto px-5 lg:px-8">
      <a href="/en/" class="inline-block text-sm text-[var(--color-text-muted)] hover:text-[var(--color-navy)] transition-colors mb-8">← Back home</a>
      <header class="mb-8">
        <h1 class="font-heading text-3xl sm:text-5xl leading-tight mb-4">Free operations diagnostic</h1>
        <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed">Tell us how your business works today and what becomes harder when work picks up. We review the process, look for the cause, and see which change could have the most impact.</p>
      </header>
      <div class="mb-5 flex flex-col sm:flex-row gap-4 text-sm text-[var(--color-text-muted)]">
        <span>— 5 minutes.</span>
        <span>— No cost.</span>
        <span>— We understand the problem first, then evaluate what is worth changing.</span>
      </div>
      <p class="mb-8 text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed">Your answers are the starting point for your Operation X-Ray.</p>
      <DiagnosticoForm lang={lang} />
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
