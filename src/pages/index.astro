---
import BaseLayout from "../layouts/BaseLayout.astro";
import Home2026 from "../components/Home2026.astro";
import SeoFaq from "../components/SeoFaq.astro";
import { translations } from "../i18n/translations";

const lang = "es";
const t = translations[lang];
---

<BaseLayout lang={lang} title={t.homeTitle} description={t.homeDescription} season={true}>
  <Fragment slot="head">
    <!-- Fraunces (normal + cursiva) pinta el titular de Smart Tap en la primera pantalla.
         Sin precarga, el titular cambia de número de líneas al llegar la fuente y empuja el texto de abajo (CLS). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin-wght-italic.woff2" crossorigin />
  </Fragment>
  <div class="home-with-seo-faq">
    <Home2026 lang={lang} />
    <SeoFaq lang={lang} />
  </div>
</BaseLayout>

<style is:global>
  .home-with-seo-faq { display: flex; flex-direction: column; }
  .home-with-seo-faq > header { order: 0; }
  .home-with-seo-faq > main { order: 1; }
  .home-with-seo-faq > .seo-faq { order: 2; }
  .home-with-seo-faq > footer { order: 3; }
  .home-with-seo-faq > main .faq { display: none; }
</style>
