---
import BaseLayout from "../layouts/BaseLayout.astro";
import Home2026 from "../components/Home2026.astro";
import SeoFaq from "../components/SeoFaq.astro";

const lang = "es";
---

<BaseLayout lang={lang}>
  <div class="home-with-seo-faq">
    <Home2026 lang={lang} />
    <SeoFaq lang={lang} />
  </div>
</BaseLayout>

<style is:global>
  .home-with-seo-faq > main .faq { display: none; }
</style>
