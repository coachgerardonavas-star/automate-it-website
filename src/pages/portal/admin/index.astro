---
/**
 * Admin Center — "¿cuál de mis clientes necesita que intervenga?".
 *
 * Management by exception: la lista viene ordenada por urgencia, lo roto
 * primero, y arriba hay un resumen de tres cifras para no tener que leer la
 * tabla cuando todo está bien.
 *
 * Doble cierre de la puerta: RLS ya limita lo que la base devuelve, y además
 * esta ruta rechaza a cualquiera que no tenga rol admin. Si una política se
 * relajara por error, el rol sigue frenando el paso.
 */
export const prerender = false;

import PortalLayout from "../../../layouts/PortalLayout.astro";
import PortalUnconfigured from "../../../components/portal/PortalUnconfigured.astro";
import PortalCard from "../../../components/portal/PortalCard.astro";
import PageHeader from "../../../components/portal/PageHeader.astro";
import EmptyState from "../../../components/portal/EmptyState.astro";
import StatusPill from "../../../components/portal/StatusPill.astro";
import PortalIcon from "../../../components/portal/PortalIcon.astro";
import { requirePortal } from "../../../lib/portal/guard";
import { getAdminRows } from "../../../lib/portal/data";
import { portalCopy, relativeTime } from "../../../lib/portal/copy";
import { PORTAL_BASE } from "../../../lib/portal/config";
import { getSupabaseEnv } from "../../../lib/portal/supabase";
import { getSystemsHealth } from "../../../lib/portal/systems-health";

const guard = await requirePortal(Astro);
if ("redirect" in guard) return guard.redirect;
if ("unconfigured" in guard) {
  return new Response(null, { status: 302, headers: { Location: `${PORTAL_BASE}/login` } });
}

const { session, org, ctx, lang, currentPath } = guard.ok;

// Un cliente que escriba /portal/admin a mano no ve una pantalla vacía: no
// entra. Se devuelve al resumen, sin pistas de que la ruta exista.
if (session.user.role !== "admin") {
  return Astro.redirect(PORTAL_BASE);
}

const copy = portalCopy(lang);
const now = new Date();

const runtimeEnv = (Astro.locals as any)?.runtime?.env;
const env = getSupabaseEnv(runtimeEnv);
const result = await getAdminRows(session.orgs, env, ctx?.accessToken ?? null);
const rows = result.data;

// Infraestructura propia. Se muestra en su propio bloque, separado de la lista
// de clientes: son dos preguntas distintas y mezclarlas llevaría a creer que un
// cliente está sano porque nuestros workers responden.
const systems = await getSystemsHealth(runtimeEnv);

const SYSTEM_TONE = { ok: "ok", down: "danger", unknown: "neutral" } as const;

const counts = {
  healthy: rows.filter((r) => r.status === "healthy").length,
  needs_attention: rows.filter((r) => r.status === "needs_attention").length,
  critical: rows.filter((r) => r.status === "critical").length,
};

const STATUS_TONE = { healthy: "ok", needs_attention: "warn", critical: "danger" } as const;

const summary = [
  { key: "critical", count: counts.critical, label: copy.admin.summaryCritical, tone: "danger" as const },
  { key: "needs_attention", count: counts.needs_attention, label: copy.admin.summaryAttention, tone: "warn" as const },
  { key: "healthy", count: counts.healthy, label: copy.admin.summaryHealthy, tone: "ok" as const },
];

// --- Comercial ---------------------------------------------------------------
// Se suma solo lo que Stripe confirma como activo. Incluir un `past_due` en el
// ingreso mensual sería contar plata que todavía no entró.
const mrrTotal = rows.reduce(
  (t, r) => t + (r.commercial?.billingStatus === "active" ? (r.commercial.mrrCents ?? 0) : 0),
  0
);

const renewingSoon = rows.filter(
  (r) => r.commercial?.daysToRenewal != null && r.commercial.daysToRenewal <= 30
).length;

const money = (cents: number) =>
  (cents / 100).toLocaleString(lang === "en" ? "en-US" : "es-US", {
    style: "currency", currency: "USD", maximumFractionDigits: 0,
  });

/** Texto del vencimiento. Un contrato vencido no se dibuja como "en -3 días". */
function renewalText(c: NonNullable<typeof rows[number]["commercial"]>): string {
  if (c.daysToRenewal == null) return copy.admin.noContract;
  if (c.daysToRenewal < 0) return copy.admin.renewalOverdue.replace("{n}", String(Math.abs(c.daysToRenewal)));
  if (c.daysToRenewal === 0) return copy.admin.renewsToday;
  return copy.admin.renewsInDays.replace("{n}", String(c.daysToRenewal));
}

/** Urgencia del vencimiento: dentro de una semana es rojo, dentro de un mes ámbar. */
function renewalTone(c: NonNullable<typeof rows[number]["commercial"]>) {
  if (c.cancelAtPeriodEnd) return "danger" as const;
  if (c.daysToRenewal == null) return "neutral" as const;
  if (c.daysToRenewal <= 7) return "danger" as const;
  if (c.daysToRenewal <= 30) return "warn" as const;
  return "ok" as const;
}

/**
 * Un espejo desactualizado que se muestra como si fuera fresco es peor que no
 * tener espejo: se decide sobre datos muertos sin saberlo. Cualquier problema
 * de sincronización se dice en pantalla.
 */
function syncWarning(c: NonNullable<typeof rows[number]["commercial"]>): string | null {
  if (c.syncError) return copy.admin.syncFailed;
  if (!c.syncedAt) return copy.admin.syncNever;
  const horas = (now.getTime() - new Date(c.syncedAt).getTime()) / 3_600_000;
  return horas > 24 ? copy.admin.syncStale : null;
}

const TONE_TEXT = {
  danger: "text-[#B3261E]",
  warn: "text-[#8A5A00]",
  ok: "text-[#1F7A4D]",
};
---

{!org ? (
  <PortalUnconfigured lang={lang} />
) : (
  <PortalLayout
    lang={lang}
    title={copy.admin.title}
    user={session.user}
    orgs={session.orgs}
    activeOrg={org}
    currentPath={currentPath}
  >
    <PageHeader title={copy.admin.title} question={copy.admin.question} />

    {result.failedSources.length > 0 && (
      <p
        role="status"
        class="mb-4 rounded-lg border border-[var(--color-warning)]/35 bg-[var(--color-warning-bg)] px-4 py-3 text-sm text-[#6B4700]"
      >
        {copy.error.partial}
      </p>
    )}

    {/* Infraestructura de Automate IT. Va arriba porque si el formulario de
        diagnóstico está caído, eso importa más que cualquier fila de la lista:
        no entra un solo lead y nada lo hace visible en el sitio. */}
    <PortalCard
      title={copy.admin.systemsTitle}
      class="mb-4 sm:mb-6"
      flush={Boolean(systems)}
    >
      {!systems ? (
        <p class="text-sm text-[var(--color-text-muted)]">
          {copy.admin.systemsUnavailable}
        </p>
      ) : (
        <>
          <p class="px-4 pb-1 pt-2 text-xs text-[var(--color-text-muted)] sm:px-5">
            {copy.admin.systemsSubtitle}
          </p>
          <ul class="grid grid-cols-1 gap-px bg-[var(--color-border)] sm:grid-cols-2 xl:grid-cols-3">
            {systems.systems.map((s) => (
              <li class="flex items-center justify-between gap-3 bg-white px-4 py-3 sm:px-5">
                <span class="min-w-0">
                  <span class="block truncate text-sm font-medium text-[var(--color-text-secondary)]">
                    {s.name}
                  </span>
                  {s.tier0 && (
                    <span class="text-[10px] font-semibold uppercase tracking-wide text-[var(--color-text-subtle)]">
                      {copy.admin.systemsTier0}
                    </span>
                  )}
                </span>
                <StatusPill
                  tone={SYSTEM_TONE[s.status]}
                  label={
                    s.status === "ok"
                      ? copy.admin.systemsOk
                      : s.status === "down"
                        ? copy.admin.systemsDown
                        : copy.admin.systemsUnknown
                  }
                />
              </li>
            ))}
          </ul>
        </>
      )}
    </PortalCard>

    <div class="mb-4 grid grid-cols-3 gap-3 sm:mb-6 sm:gap-4">
      {summary.map((s) => (
        <div class="rounded-lg border border-[var(--color-border)] bg-white p-4 shadow-[var(--shadow-card)]">
          <p class:list={["font-heading text-2xl leading-none sm:text-3xl", TONE_TEXT[s.tone]]}>
            {s.count}
          </p>
          <p class="mt-1 text-xs leading-tight text-[var(--color-text-muted)]">{s.label}</p>
        </div>
      ))}
    </div>

    {/* Comercial. Va en su propia fila, separado de la salud: "cuánto facturo"
        y "qué está roto" son preguntas distintas, y mezclarlas en la misma
        tarjeta lleva a leer un ingreso sano como un sistema sano. */}
    <div class="mb-4 grid grid-cols-2 gap-3 sm:mb-6 sm:gap-4">
      <div class="rounded-lg border border-[var(--color-border)] bg-white p-4 shadow-[var(--shadow-card)]">
        <p class="font-heading text-2xl leading-none sm:text-3xl">{money(mrrTotal)}</p>
        <p class="mt-1 text-xs leading-tight text-[var(--color-text-muted)]">{copy.admin.mrrTotal}</p>
      </div>
      <div class="rounded-lg border border-[var(--color-border)] bg-white p-4 shadow-[var(--shadow-card)]">
        <p
          class:list={[
            "font-heading text-2xl leading-none sm:text-3xl",
            renewingSoon > 0 ? TONE_TEXT.warn : "",
          ]}
        >
          {renewingSoon}
        </p>
        <p class="mt-1 text-xs leading-tight text-[var(--color-text-muted)]">{copy.admin.renewingSoon}</p>
      </div>
    </div>

    {rows.length === 0 ? (
      <PortalCard>
        <EmptyState title={copy.empty.generic} icon="shield-check" />
      </PortalCard>
    ) : counts.critical === 0 && counts.needs_attention === 0 ? (
      <PortalCard class="mb-4 sm:mb-6">
        <div class="flex items-start gap-3">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#E4F7EC] text-[#1F7A4D]">
            <PortalIcon name="circle-check" size={18} />
          </span>
          <p class="text-sm text-[var(--color-text-secondary)]">{copy.admin.allHealthy}</p>
        </div>
      </PortalCard>
    ) : null}

    {rows.length > 0 && (
      <>
        {/* Teléfono: fichas apiladas. */}
        <ul class="space-y-3 lg:hidden">
          {rows.map((r) => (
            <li>
              <a
                href={`${PORTAL_BASE}/admin/${r.slug}`}
                class="block rounded-lg border border-[var(--color-border)] bg-white p-4 shadow-[var(--shadow-card)] transition-colors duration-200 ease-brand hover:border-[var(--color-blue)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-blue)]"
              >
                <div class="flex items-center justify-between gap-3">
                  <p class="truncate text-sm font-semibold">{r.name}</p>
                  <StatusPill tone={STATUS_TONE[r.status]} label={copy.admin[r.status]} />
                </div>
                {r.commercial && (
                  <p class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                    <StatusPill
                      tone={renewalTone(r.commercial)}
                      label={r.commercial.cancelAtPeriodEnd
                        ? copy.admin.cancelling
                        : `${copy.admin.renewal} ${renewalText(r.commercial)}`}
                    />
                    {r.commercial.mrrCents != null && (
                      <span class="font-semibold">{money(r.commercial.mrrCents)}</span>
                    )}
                  </p>
                )}
                <dl class="mt-3 grid grid-cols-3 gap-2 border-t border-[var(--color-border)] pt-3 text-xs">
                  <div>
                    <dt class="text-[var(--color-text-subtle)]">{copy.admin.failures7d}</dt>
                    <dd class="font-semibold">{r.failures7d || "—"}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-text-subtle)]">{copy.admin.alerts}</dt>
                    <dd class="font-semibold">{r.openAlerts || "—"}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-text-subtle)]">{copy.admin.lastLogin}</dt>
                    <dd class="font-semibold">
                      {r.engagement.lastLoginAt
                        ? relativeTime(copy, r.engagement.lastLoginAt, now)
                        : copy.admin.neverEntered}
                    </dd>
                  </div>
                </dl>
              </a>
            </li>
          ))}
        </ul>

        {/* Escritorio: tabla. */}
        <PortalCard class="hidden lg:block" flush>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--color-border)] text-xs uppercase tracking-wide text-[var(--color-text-subtle)]">
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.admin.client}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.admin.status}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.admin.renewal}</th>
                  <th scope="col" class="px-5 py-3 text-right font-semibold">{copy.admin.mrr}</th>
                  <th scope="col" class="px-5 py-3 text-right font-semibold">{copy.admin.failures7d}</th>
                  <th scope="col" class="px-5 py-3 text-right font-semibold">{copy.admin.alerts}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.admin.lastLogin}</th>
                  <th scope="col" class="px-5 py-3"><span class="sr-only">{copy.admin.openClient}</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--color-border)]">
                {rows.map((r) => (
                  <tr class="transition-colors duration-200 ease-brand hover:bg-neutral-50">
                    <td class="px-5 py-4 font-semibold">
                      {r.name}
                      {r.commercial?.plan && (
                        <span class="mt-0.5 block text-xs font-normal text-[var(--color-text-subtle)]">
                          {r.commercial.plan}
                        </span>
                      )}
                    </td>
                    <td class="px-5 py-4">
                      <StatusPill tone={STATUS_TONE[r.status]} label={copy.admin[r.status]} />
                    </td>
                    <td class="px-5 py-4 whitespace-nowrap">
                      {!r.commercial ? (
                        <span class="text-[var(--color-text-subtle)]">{copy.admin.noContract}</span>
                      ) : (
                        <>
                          <StatusPill
                            tone={renewalTone(r.commercial)}
                            label={r.commercial.cancelAtPeriodEnd
                              ? copy.admin.cancelling
                              : renewalText(r.commercial)}
                          />
                          {syncWarning(r.commercial) && (
                            <span class="mt-1 block text-[11px] text-[#8A5A00]">
                              {syncWarning(r.commercial)}
                            </span>
                          )}
                        </>
                      )}
                    </td>
                    <td class="px-5 py-4 text-right whitespace-nowrap">
                      {r.commercial?.mrrCents != null
                        ? money(r.commercial.mrrCents)
                        : <span class="text-[var(--color-text-subtle)]">—</span>}
                    </td>
                    <td class="px-5 py-4 text-right">
                      {r.failures7d === 0 ? (
                        <span class="text-[var(--color-text-subtle)]">—</span>
                      ) : (
                        <span class="font-semibold text-[#B3261E]">{r.failures7d}</span>
                      )}
                    </td>
                    <td class="px-5 py-4 text-right">
                      {r.openAlerts === 0 ? (
                        <span class="text-[var(--color-text-subtle)]">—</span>
                      ) : (
                        <span class="font-semibold text-[#B3261E]">{r.openAlerts}</span>
                      )}
                    </td>
                    <td class="px-5 py-4 whitespace-nowrap text-[var(--color-text-muted)]">
                      {/* El mejor predictor de que no renueva: deja de mirar
                          antes de avisar que se va. */}
                      {r.engagement.lastLoginAt
                        ? relativeTime(copy, r.engagement.lastLoginAt, now)
                        : <span class="text-[#8A5A00]">{copy.admin.neverEntered}</span>}
                      {!r.engagement.sawReports30d && (
                        <span class="mt-0.5 block text-[11px] text-[var(--color-text-subtle)]">
                          {copy.admin.notSeenReports}
                        </span>
                      )}
                    </td>
                    <td class="px-5 py-4 text-right">
                      <a
                        href={`${PORTAL_BASE}/admin/${r.slug}`}
                        class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-blue)] hover:underline"
                      >
                        {copy.admin.openClient}
                        <PortalIcon name="arrow-right" size={14} />
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </PortalCard>
      </>
    )}
  </PortalLayout>
)}

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
