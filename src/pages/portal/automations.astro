---
/**
 * Automations — "¿está funcionando mi sistema?".
 *
 * Monitorización, no editor: en V1 no se puede modificar un flujo desde acá
 * (handoff §13). El cliente ve nombre humano, estado y volumen de trabajo.
 * Nunca ve scenario id, webhook, worker ni respuesta HTTP — ese detalle vive en
 * `automation_internals`, que RLS solo abre al rol admin.
 */
export const prerender = false;

import PortalLayout from "../../layouts/PortalLayout.astro";
import PortalUnconfigured from "../../components/portal/PortalUnconfigured.astro";
import PortalCard from "../../components/portal/PortalCard.astro";
import PageHeader from "../../components/portal/PageHeader.astro";
import EmptyState from "../../components/portal/EmptyState.astro";
import DemoBanner from "../../components/portal/DemoBanner.astro";
import StatusPill from "../../components/portal/StatusPill.astro";
import PortalIcon from "../../components/portal/PortalIcon.astro";
import { requirePortal } from "../../lib/portal/guard";
import { getOverview } from "../../lib/portal/data";
import { portalCopy, relativeTime } from "../../lib/portal/copy";
import { PORTAL_BASE } from "../../lib/portal/config";

const guard = await requirePortal(Astro);
if ("redirect" in guard) return guard.redirect;
if ("unconfigured" in guard) {
  return new Response(null, { status: 302, headers: { Location: `${PORTAL_BASE}/login` } });
}

const { session, org, ctx, lang, currentPath } = guard.ok;
const copy = portalCopy(lang);
const now = new Date();

const result = ctx ? await getOverview(ctx, "30d") : null;
const mode = result?.mode ?? "demo";
const automations = result?.data.automations ?? [];
const integrations = result?.data.integrations ?? [];

const TONE = { running: "ok", needs_attention: "warn", unavailable: "danger" } as const;
const units = copy.units as Record<string, string>;
---

{!org ? (
  <PortalUnconfigured lang={lang} />
) : (
  <PortalLayout
    lang={lang}
    title={copy.pages.automations.title}
    user={session.user}
    orgs={session.orgs}
    activeOrg={org}
    currentPath={currentPath}
  >
    <PageHeader title={copy.pages.automations.title} question={copy.pages.automations.question} />
    <DemoBanner lang={lang} mode={mode} />

    {automations.length === 0 ? (
      <PortalCard>
        <EmptyState
          title={copy.empty.automations}
          body={copy.empty.automationsBody}
          icon="workflow"
        />
      </PortalCard>
    ) : (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {automations.map((a) => (
          <article class="rounded-lg border border-[var(--color-border)] bg-white p-5 shadow-[var(--shadow-card)]">
            <div class="flex items-start gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-[var(--color-info-bg)] text-[var(--color-blue)]">
                <PortalIcon name={a.icon} size={20} />
              </span>
              <div class="min-w-0 flex-1">
                <h2 class="truncate text-sm font-semibold">{a.name}</h2>
                <div class="mt-1.5">
                  <StatusPill tone={TONE[a.state]} label={copy.automationState[a.state]} />
                </div>
              </div>
            </div>

            <dl class="mt-4 border-t border-[var(--color-border)] pt-4">
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-xs text-[var(--color-text-muted)]">
                  {units[a.unitLabel] ?? a.unitLabel}
                </dt>
                <dd class="font-heading text-2xl leading-none text-[var(--color-text-primary)]">
                  {a.volume}
                </dd>
              </div>
              {a.lastActivityAt && (
                <div class="mt-2 flex items-baseline justify-between gap-3">
                  <dt class="text-xs text-[var(--color-text-muted)]">{copy.admin.lastActivity}</dt>
                  <dd class="text-xs font-semibold text-[var(--color-text-secondary)]">
                    {relativeTime(copy, a.lastActivityAt, now)}
                  </dd>
                </div>
              )}
            </dl>
          </article>
        ))}
      </div>
    )}

    {integrations.length > 0 && (
      <PortalCard title={copy.sections.integrations} class="mt-4 sm:mt-6">
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {integrations.map((i) => (
            <li class="flex items-center justify-between gap-3 rounded-md border border-[var(--color-border)] bg-neutral-50 px-4 py-3">
              <span class="truncate text-sm font-medium text-[var(--color-text-secondary)]">
                {i.name}
              </span>
              <StatusPill
                tone={i.state === "connected" ? "ok" : i.state === "degraded" ? "warn" : "danger"}
                label={copy.integrationState[i.state]}
              />
            </li>
          ))}
        </ul>
      </PortalCard>
    )}
  </PortalLayout>
)}
