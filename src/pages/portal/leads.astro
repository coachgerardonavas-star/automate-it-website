---
/**
 * Leads — "¿quién necesita mi atención?".
 *
 * No reconstruye el CRM: lo resume. Cada ficha lleva, cuando existe, un enlace
 * al registro real (handoff §9). Lo que aporta esta pantalla sobre HubSpot es el
 * orden — primero quien está caliente y lleva más tiempo esperando.
 *
 * En teléfono no hay tabla: una tabla de nueve columnas en 375px es ilegible
 * mirés como la mirés. Se muestran fichas apiladas con la misma información.
 */
export const prerender = false;

import PortalLayout from "../../layouts/PortalLayout.astro";
import PortalUnconfigured from "../../components/portal/PortalUnconfigured.astro";
import PortalCard from "../../components/portal/PortalCard.astro";
import PageHeader from "../../components/portal/PageHeader.astro";
import StatusPill from "../../components/portal/StatusPill.astro";
import EmptyState from "../../components/portal/EmptyState.astro";
import DemoBanner from "../../components/portal/DemoBanner.astro";
import PortalIcon from "../../components/portal/PortalIcon.astro";
import { requirePortal } from "../../lib/portal/guard";
import { getLeads } from "../../lib/portal/data";
import { portalCopy, maybeDemo, relativeTime } from "../../lib/portal/copy";
import { PORTAL_BASE } from "../../lib/portal/config";

const guard = await requirePortal(Astro);
if ("redirect" in guard) return guard.redirect;
if ("unconfigured" in guard) {
  return new Response(null, { status: 302, headers: { Location: `${PORTAL_BASE}/login` } });
}

const { session, org, ctx, lang, currentPath } = guard.ok;
const copy = portalCopy(lang);
const now = new Date();

const result = ctx ? await getLeads(ctx) : null;
const mode = result?.mode ?? "demo";
const leads = result?.data ?? [];

const filter = Astro.url.searchParams.get("t");
const TEMPS = ["hot", "warm", "cold", "unclassified"] as const;
const active = TEMPS.includes(filter as any) ? (filter as (typeof TEMPS)[number]) : null;
const shown = active ? leads.filter((l) => l.temperature === active) : leads;

const TEMP_TONE = { hot: "danger", warm: "warn", cold: "info", unclassified: "neutral" } as const;
---

{!org ? (
  <PortalUnconfigured lang={lang} />
) : (
  <PortalLayout
    lang={lang}
    title={copy.leads.title}
    user={session.user}
    orgs={session.orgs}
    activeOrg={org}
    currentPath={currentPath}
  >
    <PageHeader title={copy.leads.title} question={copy.leads.question} />
    <DemoBanner lang={lang} mode={mode} />

    {/* Filtros en una sola fila por encima del contenido. Enlaces y no botones:
        el filtro queda en la URL y la pantalla se puede compartir. */}
    <div class="mb-4 flex flex-wrap gap-2">
      <a
        href="?"
        class:list={[
          "rounded-full px-3 py-1.5 text-xs font-semibold transition-colors duration-200 ease-brand",
          !active
            ? "bg-[var(--color-blue)] text-white"
            : "border border-[var(--color-border)] bg-white text-[var(--color-text-secondary)] hover:bg-neutral-100",
        ]}
      >
        {copy.leads.all} ({leads.length})
      </a>
      {TEMPS.map((t) => {
        const count = leads.filter((l) => l.temperature === t).length;
        return (
          <a
            href={`?t=${t}`}
            class:list={[
              "rounded-full px-3 py-1.5 text-xs font-semibold transition-colors duration-200 ease-brand",
              active === t
                ? "bg-[var(--color-blue)] text-white"
                : "border border-[var(--color-border)] bg-white text-[var(--color-text-secondary)] hover:bg-neutral-100",
            ]}
          >
            {copy.temperature[t]} ({count})
          </a>
        );
      })}
    </div>

    {shown.length === 0 ? (
      <PortalCard>
        <EmptyState title={copy.empty.leads} body={copy.empty.leadsBody} icon="user-round-search" />
      </PortalCard>
    ) : (
      <>
        {/* Teléfono y tablet: fichas. */}
        <ul class="space-y-3 lg:hidden">
          {shown.map((l) => (
            <li class="rounded-lg border border-[var(--color-border)] bg-white p-4 shadow-[var(--shadow-card)]">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-sm font-semibold">{l.name}</p>
                <StatusPill tone={TEMP_TONE[l.temperature]} label={copy.temperature[l.temperature]} />
              </div>
              <p class="mt-1 text-sm text-[var(--color-text-secondary)]">
                {maybeDemo(copy, mode, l.interest)}
              </p>
              <p class="mt-1 text-xs leading-relaxed text-[var(--color-text-muted)]">
                {maybeDemo(copy, mode, l.summary)}
              </p>
              <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-[var(--color-border)] pt-3 text-xs">
                <div>
                  <dt class="text-[var(--color-text-subtle)]">{copy.leads.source}</dt>
                  <dd class="font-semibold text-[var(--color-text-secondary)]">{l.source || "—"}</dd>
                </div>
                <div>
                  <dt class="text-[var(--color-text-subtle)]">{copy.leads.lastActivity}</dt>
                  <dd class="font-semibold text-[var(--color-text-secondary)]">
                    {relativeTime(copy, l.lastActivityAt, now)}
                  </dd>
                </div>
                <div class="col-span-2">
                  <dt class="text-[var(--color-text-subtle)]">{copy.leads.nextStep}</dt>
                  <dd class="font-semibold text-[var(--color-text-secondary)]">
                    {maybeDemo(copy, mode, l.nextAction)}
                  </dd>
                </div>
              </dl>
              {l.crmUrl && (
                <a
                  href={l.crmUrl}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-blue)] hover:underline"
                >
                  {copy.leads.openInCrm}
                  <PortalIcon name="external-link" size={14} />
                </a>
              )}
            </li>
          ))}
        </ul>

        {/* Escritorio: tabla. Envuelta en un contenedor con scroll propio para
            que una fila ancha nunca empuje el layout de la página. */}
        <PortalCard class="hidden lg:block" flush>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[64rem] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[var(--color-border)] text-xs uppercase tracking-wide text-[var(--color-text-subtle)]">
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.leads.name}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.leads.source}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.leads.interest}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.leads.nextStep}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.leads.owner}</th>
                  <th scope="col" class="px-5 py-3 font-semibold">{copy.leads.lastActivity}</th>
                  <th scope="col" class="px-5 py-3"><span class="sr-only">{copy.leads.openInCrm}</span></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--color-border)]">
                {shown.map((l) => (
                  <tr class="align-top transition-colors duration-200 ease-brand hover:bg-neutral-50">
                    <td class="px-5 py-4">
                      <p class="font-semibold">{l.name}</p>
                      <div class="mt-1">
                        <StatusPill tone={TEMP_TONE[l.temperature]} label={copy.temperature[l.temperature]} />
                      </div>
                    </td>
                    <td class="px-5 py-4 text-[var(--color-text-secondary)]">{l.source || "—"}</td>
                    <td class="px-5 py-4">
                      <p class="text-[var(--color-text-secondary)]">{maybeDemo(copy, mode, l.interest)}</p>
                      <p class="mt-1 max-w-xs text-xs text-[var(--color-text-muted)]">
                        {maybeDemo(copy, mode, l.summary)}
                      </p>
                    </td>
                    <td class="px-5 py-4 text-[var(--color-text-secondary)]">
                      {maybeDemo(copy, mode, l.nextAction)}
                    </td>
                    <td class="px-5 py-4 text-[var(--color-text-secondary)]">{l.owner ?? "—"}</td>
                    <td class="px-5 py-4 whitespace-nowrap text-[var(--color-text-muted)]">
                      {relativeTime(copy, l.lastActivityAt, now)}
                    </td>
                    <td class="px-5 py-4 text-right">
                      {l.crmUrl ? (
                        <a
                          href={l.crmUrl}
                          rel="noopener noreferrer"
                          target="_blank"
                          class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-blue)] hover:underline"
                        >
                          {copy.leads.openInCrm}
                          <PortalIcon name="external-link" size={14} />
                        </a>
                      ) : (
                        <span class="text-xs text-[var(--color-text-subtle)]">—</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </PortalCard>
      </>
    )}
  </PortalLayout>
)}

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
