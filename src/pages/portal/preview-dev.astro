---
/**
 * Previsualización del portal — SOLO en desarrollo.
 *
 * Existe para poder revisar la interfaz (y sobre todo el comportamiento en
 * teléfono) sin tener la base conectada. Fabrica una sesión falsa en memoria y
 * renderiza el Overview con los datos sembrados.
 *
 * Por qué es seguro: `import.meta.env.DEV` es `false` en el build de
 * producción, así que en producción esta ruta responde 404 y ni siquiera llega
 * a construir la sesión. No hay forma de que sirva de puerta trasera — no lee
 * cookies, no consulta la base y no emite ningún token.
 *
 * Si algún día hace falta borrarla, se puede: no la importa nadie.
 */
export const prerender = false;

import PortalLayout from "../../layouts/PortalLayout.astro";
import PortalCard from "../../components/portal/PortalCard.astro";
import KpiCard from "../../components/portal/KpiCard.astro";
import StatusPill from "../../components/portal/StatusPill.astro";
import DemoBanner from "../../components/portal/DemoBanner.astro";
import ActivityChart from "../../components/portal/ActivityChart.astro";
import Sparkline from "../../components/portal/Sparkline.astro";
import PortalIcon from "../../components/portal/PortalIcon.astro";
import { demoOverview } from "../../lib/portal/demo-data";
import { portalCopy, demoText, relativeTime } from "../../lib/portal/copy";
import { PORTAL_BASE } from "../../lib/portal/config";
import type { Organization, PortalUser } from "../../lib/portal/types";

if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "es";
const copy = portalCopy(lang);
const now = new Date();
const d = demoOverview(now);

const user: PortalUser = {
  id: "preview",
  email: "carlos@example.com",
  fullName: "Carlos Méndez",
  role: "admin",
  locale: lang,
};

const org: Organization = {
  id: "preview-org",
  name: "Carlos Plumbing",
  slug: "carlos-plumbing",
  status: "healthy",
  dataMode: "demo",
  accountManager: "Gabriela",
};

const KPI_META: Record<string, { icon: string; tone: "blue" | "green" | "purple" | "cyan" }> = {
  newLeads: { icon: "users", tone: "blue" },
  handledAutomatically: { icon: "circle-check", tone: "green" },
  appointmentsBooked: { icon: "calendar", tone: "purple" },
  hoursSaved: { icon: "clock", tone: "cyan" },
};
const AUTOMATION_TONE = { running: "ok", needs_attention: "warn", unavailable: "danger" } as const;
const TEMP_TONE = { hot: "danger", warm: "warn", cold: "info", unclassified: "neutral" } as const;
const units = copy.units as Record<string, string>;
const metricLabels = copy.metrics as Record<string, string>;
---

<PortalLayout
  lang={lang}
  title={copy.nav.overview}
  user={user}
  orgs={[org]}
  activeOrg={org}
  currentPath={PORTAL_BASE}
>
  <div class="mb-4 sm:mb-6">
    <h1 class="font-heading text-2xl leading-tight sm:text-3xl">
      {copy.greeting.morning}, Carlos.
    </h1>
    <p class="mt-1 text-sm text-[var(--color-text-secondary)]">{copy.greeting.subtitle}</p>
  </div>

  <DemoBanner lang={lang} mode="demo" />

  <div class="space-y-4 sm:space-y-6">
    <div class="grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4">
      {d.kpis.map((kpi) => (
        <KpiCard
          lang={lang}
          kpi={kpi}
          icon={KPI_META[kpi.key].icon}
          tone={KPI_META[kpi.key].tone}
        />
      ))}
    </div>

    <div class="grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-12">
      <PortalCard
        title={copy.sections.needsAttention}
        actionLabel={copy.sections.viewAll}
        actionHref={`${PORTAL_BASE}/leads`}
        class="order-1 lg:order-3 lg:col-span-3"
        flush
      >
        <ul class="divide-y divide-[var(--color-border)] px-4 pb-2 pt-3 sm:px-5">
          {d.attention.map((item) => (
            <li class="py-3">
              <div class="flex flex-wrap items-center gap-2">
                <p class="truncate text-sm font-semibold">{item.name}</p>
                <StatusPill tone={TEMP_TONE[item.temperature]} label={copy.temperature[item.temperature]} />
              </div>
              <p class="mt-0.5 text-xs text-[var(--color-text-muted)]">
                {demoText(copy, item.reason)}
              </p>
              <p class="mt-0.5 text-[11px] text-[var(--color-text-subtle)]">
                {relativeTime(copy, item.at, now)}
              </p>
            </li>
          ))}
        </ul>
      </PortalCard>

      <PortalCard title={copy.sections.customerActivity} class="order-3 lg:order-1 lg:col-span-5">
        <ActivityChart lang={lang} points={d.activity} label={copy.units.conversations} />
      </PortalCard>

      <PortalCard
        title={copy.sections.yourAutomations}
        actionLabel={copy.sections.viewAll}
        actionHref={`${PORTAL_BASE}/automations`}
        class="order-2 lg:col-span-4"
        flush
      >
        <ul class="divide-y divide-[var(--color-border)] px-4 pb-2 pt-3 sm:px-5">
          {d.automations.map((a) => (
            <li class="flex items-center gap-3 py-3">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-md bg-neutral-100 text-[var(--color-text-secondary)]">
                <PortalIcon name={a.icon} size={18} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold">{a.name}</p>
                <StatusPill tone={AUTOMATION_TONE[a.state]} label={copy.automationState[a.state]} />
              </div>
              <div class="shrink-0 text-right">
                <p class="font-heading text-base leading-none">{a.volume}</p>
                <p class="mt-1 text-[11px] text-[var(--color-text-subtle)]">
                  {units[a.unitLabel] ?? a.unitLabel}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </PortalCard>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-12">
      <PortalCard title={copy.sections.recentActivity} class="lg:col-span-4" flush>
        <ul class="px-4 pb-3 pt-3 sm:px-5">
          {d.recentActivity.map((item) => (
            <li class="flex items-start gap-3 py-2.5">
              <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-neutral-100 text-[var(--color-text-muted)]">
                <PortalIcon name="message-square" size={14} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm leading-snug">{demoText(copy, item.summary)}</p>
                <p class="mt-0.5 text-[11px] text-[var(--color-text-subtle)]">
                  {relativeTime(copy, item.at, now)}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </PortalCard>

      <PortalCard title={copy.sections.businessInsights} class="lg:col-span-4">
        <ul class="divide-y divide-[var(--color-border)]">
          {d.businessMetrics.map((m) => (
            <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0">
              <div class="min-w-0 flex-1">
                <p class="text-xs text-[var(--color-text-muted)]">{metricLabels[m.key]}</p>
                <div class="mt-0.5 flex items-baseline gap-2">
                  <span class="font-heading text-lg leading-none">{m.value}</span>
                  <span
                    class:list={["text-xs font-semibold", (m.delta ?? 0) >= 0 ? "text-[#1F7A4D]" : "text-[#B3261E]"]}
                  >
                    {(m.delta ?? 0) >= 0 ? "+" : ""}{m.delta}%
                  </span>
                </div>
                <p class="mt-0.5 text-[11px] text-[var(--color-text-subtle)]">
                  {copy.metrics.vsLastMonth}
                </p>
              </div>
              <Sparkline values={m.series} tone={(m.delta ?? 0) >= 0 ? "green" : "blue"} label={metricLabels[m.key]} />
            </li>
          ))}
        </ul>
      </PortalCard>

      <div class="space-y-4 sm:space-y-6 lg:col-span-4">
        <PortalCard title={copy.sections.integrations}>
          <ul class="space-y-2">
            {d.integrations.map((i) => (
              <li class="flex items-center justify-between gap-3">
                <span class="truncate text-sm text-[var(--color-text-secondary)]">{i.name}</span>
                <StatusPill tone="ok" label={copy.integrationState[i.state]} />
              </li>
            ))}
          </ul>
        </PortalCard>
      </div>
    </div>

    <PortalCard>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <div class="shrink-0">
          <p class="text-sm font-semibold">{copy.sections.workHandled}</p>
          <p class="mt-1 font-heading text-4xl leading-none text-[var(--color-blue)]">
            {d.workHandled.total}
          </p>
          <p class="mt-1 max-w-[15rem] text-xs leading-snug text-[var(--color-text-muted)]">
            {copy.sections.workHandledSuffix}
          </p>
        </div>
        <ul class="grid flex-1 grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-6">
          {d.workHandled.breakdown.map((b) => (
            <li class="rounded-md border border-[var(--color-border)] bg-neutral-50 px-3 py-2.5">
              <p class="font-heading text-lg leading-none">{b.count}</p>
              <p class="mt-1 text-[11px] leading-tight text-[var(--color-text-muted)]">
                {units[b.key] ?? b.key}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </PortalCard>
  </div>
</PortalLayout>
