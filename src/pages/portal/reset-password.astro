---
/**
 * Recuperación de contraseña del portal.
 *
 * Una sola ruta con dos modos, porque son dos mitades del mismo trámite:
 *
 *   1. PEDIR   — sin token: se escribe el correo y GoTrue manda el enlace.
 *   2. CAMBIAR — con token: se elige la contraseña nueva.
 *
 * El modo lo decide el navegador, no el servidor, y eso no es un capricho: el
 * enlace del correo trae el token en el FRAGMENTO de la URL
 * (`#access_token=...`), y el fragmento nunca viaja en la petición HTTP. El
 * servidor no puede verlo. Por eso el script de abajo lo levanta, lo mete en un
 * campo oculto y muestra el formulario que corresponde.
 *
 * La llamada a GoTrue sigue saliendo del servidor, en el POST. Así la anon key
 * no baja al navegador y esta pantalla se comporta igual que el resto del
 * portal.
 */
export const prerender = false;

import "../../styles/global.css";
import {
  getSupabaseEnv,
  requestPasswordRecovery,
  updatePassword,
} from "../../lib/portal/supabase";
import { getRuntimeEnv } from "../../lib/portal/runtime";
import { portalCopy } from "../../lib/portal/copy";
import { PORTAL_BASE } from "../../lib/portal/config";

const lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "es";
const copy = portalCopy(lang);
const loginHref = `${PORTAL_BASE}/login${lang === "en" ? "?lang=en" : ""}`;

const env = getSupabaseEnv(getRuntimeEnv());

let error: string | null = null;
let requestDone = false;

/**
 * Qué formulario se pinta desde el servidor.
 *
 * Importa por un caso concreto: si el POST de cambio falla (contraseñas que no
 * coinciden, o demasiado corta), la página se vuelve a renderizar — y para
 * entonces el fragmento de la URL ya fue borrado por el script, así que el
 * token no se puede recuperar del navegador. Sin esto, un error de tipeo
 * costaba pedir otro correo.
 *
 * Así que en ese caso el servidor devuelve el formulario de cambio ya visible y
 * con el token que vino en el POST. El script solo interviene cuando hay
 * fragmento, es decir en la primera carga desde el correo.
 */
let mode: "request" | "update" = "request";
let tokenValue = "";

if (Astro.request.method === "POST") {
  if (!env) {
    error = copy.login.unconfigured;
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get("intent") ?? "");

    if (intent === "request") {
      const email = String(form.get("email") ?? "").trim();
      if (email) {
        // El enlace tiene que volver a ESTA ruta, en el dominio desde el que se
        // pidió. Se construye con Astro.url en vez de escribirlo a mano para
        // que funcione igual en producción y en local.
        const redirectTo = new URL(
          `${PORTAL_BASE}/reset-password${lang === "en" ? "?lang=en" : ""}`,
          Astro.url.origin
        ).toString();
        await requestPasswordRecovery(env, email, redirectTo);
      }
      // Siempre el mismo acuse, haya o no cuenta con ese correo.
      requestDone = true;
    } else if (intent === "update") {
      const accessToken = String(form.get("access_token") ?? "");
      const password = String(form.get("password") ?? "");
      const confirm = String(form.get("password_confirm") ?? "");

      // Se conserva el token para que un error recuperable no obligue a pedir
      // otro correo. Si el token es el que falla, no se conserva nada: ahí sí
      // hace falta un enlace nuevo.
      if (accessToken) {
        mode = "update";
        tokenValue = accessToken;
      }

      if (!accessToken) {
        error = copy.reset.expired;
      } else if (password !== confirm) {
        error = copy.reset.mismatch;
      } else if (password.length < 8) {
        error = copy.reset.weak;
      } else {
        const result = await updatePassword(env, accessToken, password);
        if (result.ok) {
          // No se inicia sesión sola: se manda al login a estrenar la
          // contraseña. Menos estado que arrastrar y una confirmación clara de
          // que quedó cambiada.
          return Astro.redirect(
            `${loginHref}${loginHref.includes("?") ? "&" : "?"}reset=ok`
          );
        }
        if (result.reason === "expired") {
          // El token ya no sirve: reintentar con él es imposible, así que se
          // vuelve al formulario de pedir un enlace nuevo.
          error = copy.reset.expired;
          mode = "request";
          tokenValue = "";
        } else {
          error = result.reason === "weak" ? copy.reset.weak : copy.reset.failed;
        }
      }
    }
  }
}

const inputClass =
  "w-full rounded-md border border-[var(--color-border-strong)] bg-white px-3 py-2.5 text-base text-[var(--color-text-primary)] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-blue)]";
const labelClass =
  "mb-1.5 block text-sm font-medium text-[var(--color-text-secondary)]";
const buttonClass =
  "w-full rounded-sm bg-[var(--color-blue)] px-4 py-3 text-sm font-semibold text-white transition-colors duration-200 ease-brand hover:bg-[var(--color-navy)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-blue)]";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manifold-cf-extrabold.woff2"
      crossorigin="anonymous"
    />
    <title>{copy.reset.requestTitle} · {copy.brand}</title>
  </head>
  <body class="min-h-screen bg-[#F7F8FA] text-[var(--color-text-primary)] antialiased">
    <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-12">
      <div class="mb-8 text-center">
        <p class="font-heading text-2xl tracking-tight">
          AUTOMATE <span class="text-[var(--color-blue)]">IT</span>
        </p>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">{copy.tagline}</p>
      </div>

      <div class="rounded-lg border border-[var(--color-border)] bg-white p-6 shadow-[var(--shadow-card)] sm:p-8">
        {error && (
          <p
            role="alert"
            class="mb-4 rounded-md border border-[var(--color-danger)]/30 bg-[var(--color-danger-bg)] px-3 py-2 text-sm text-[#B3261E]"
          >
            {error}
          </p>
        )}

        {
          requestDone ? (
            <div>
              <h1 class="font-heading text-xl">{copy.reset.requestTitle}</h1>
              <p
                role="status"
                class="mt-4 rounded-md border border-brand-lime/40 bg-brand-lime/5 px-3 py-2 text-sm text-[var(--color-text-primary)]"
              >
                {copy.reset.requestDone}
              </p>
            </div>
          ) : (
            <div>
              {/* Modo CAMBIAR. Normalmente empieza oculto y lo muestra el
                  script al encontrar el token en el fragmento. Si el servidor
                  ya sabe que estamos en este modo — un POST que falló — se
                  pinta visible y con el token puesto, sin depender del script. */}
              <div data-mode="update" hidden={mode !== "update"}>
                <h1 class="font-heading text-xl">{copy.reset.updateTitle}</h1>

                <form method="POST" class="mt-5 space-y-4" novalidate>
                  <input type="hidden" name="intent" value="update" />
                  <input type="hidden" name="access_token" data-token value={tokenValue} />

                  <div>
                    <label class={labelClass} for="password">
                      {copy.reset.password}
                    </label>
                    <input
                      id="password"
                      name="password"
                      type="password"
                      required
                      minlength="8"
                      autocomplete="new-password"
                      class={inputClass}
                    />
                    <p class="mt-1 text-xs text-[var(--color-text-muted)]">
                      {copy.reset.hint}
                    </p>
                  </div>

                  <div>
                    <label class={labelClass} for="password_confirm">
                      {copy.reset.passwordConfirm}
                    </label>
                    <input
                      id="password_confirm"
                      name="password_confirm"
                      type="password"
                      required
                      minlength="8"
                      autocomplete="new-password"
                      class={inputClass}
                    />
                  </div>

                  <button type="submit" class={buttonClass}>
                    {copy.reset.updateSubmit}
                  </button>
                </form>
              </div>

              {/* Modo PEDIR. Es el que se ve por defecto, y también el que queda
                  cuando el enlace vino caducado: en los dos casos lo que toca
                  es pedir un correo nuevo. */}
              <div data-mode="request" hidden={mode === "update"}>
                <h1 class="font-heading text-xl">{copy.reset.requestTitle}</h1>
                <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
                  {copy.reset.requestIntro}
                </p>

                <p
                  data-no-token
                  hidden
                  class="mt-4 rounded-md border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 py-2 text-sm text-[var(--color-text-secondary)]"
                >
                  {copy.reset.noToken}
                </p>

                <form method="POST" class="mt-5 space-y-4" novalidate>
                  <input type="hidden" name="intent" value="request" />
                  <div>
                    <label class={labelClass} for="email">{copy.reset.email}</label>
                    <input
                      id="email"
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      class={inputClass}
                    />
                  </div>
                  <button type="submit" class={buttonClass}>
                    {copy.reset.requestSubmit}
                  </button>
                </form>
              </div>
            </div>
          )
        }

        <p class="mt-6 text-center text-sm">
          <a
            href={loginHref}
            class="text-[var(--color-text-muted)] underline underline-offset-2 hover:text-[var(--color-blue)]"
          >
            {copy.reset.backToLogin}
          </a>
        </p>
      </div>
    </main>

    <script is:inline>
      // El token del correo llega en el fragmento (#access_token=...), que el
      // navegador no manda al servidor. Se levanta acá, se pasa al campo oculto
      // y se decide qué formulario mostrar.
      (function () {
        var raw = window.location.hash.slice(1);
        if (!raw) return;

        var params = new URLSearchParams(raw);
        var token = params.get("access_token");
        var type = params.get("type");
        var hadError = params.get("error") || params.get("error_code");

        // Se borra el fragmento de la barra de direcciones en cuanto se lee.
        // Un token de sesión no tiene por qué quedar visible, ni viajar en un
        // enlace copiado, ni acabar en el historial.
        history.replaceState(null, "", window.location.pathname + window.location.search);

        var update = document.querySelector('[data-mode="update"]');
        var request = document.querySelector('[data-mode="request"]');
        var field = document.querySelector("[data-token]");
        var noToken = document.querySelector("[data-no-token]");
        if (!update || !request || !field) return;

        if (token && type === "recovery") {
          field.value = token;
          update.hidden = false;
          request.hidden = true;
          return;
        }

        // Vino del correo pero el enlace ya no sirve: se queda el formulario de
        // pedir, con la explicación de por qué está viendo eso.
        if (hadError && noToken) noToken.hidden = false;
      })();
    </script>
  </body>
</html>
