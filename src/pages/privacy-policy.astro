---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import LegalContent from "../components/LegalContent.astro";
import { translations } from "../i18n/translations";

const lang = "es";
const lastUpdated = "junio 2026";
const description = translations[lang].legal.privacyDescription;
const title = `${translations[lang].legal.privacy.title} · Automate IT`;
---

<BaseLayout lang={lang} title={title} description={description}>
  <Nav lang={lang} />
  <main>
    <LegalContent lang={lang} doc="privacy" lastUpdated={lastUpdated}>
      <section>
        <h2 class="font-heading text-xl sm:text-2xl mb-3 text-white">
          Biblioteca de guías y correos
        </h2>
        <p class="text-sm sm:text-base text-white/80 leading-relaxed">
          Cuando pides una guía, usamos HubSpot para guardar tu correo y qué guía pediste. También guardamos tu correo en tu propio dispositivo para no pedírtelo otra vez; puedes borrarlo con el enlace «¿No eres tú?». Puedes darte de baja con el enlace de cualquiera de nuestros correos o escribiendo a automateit@yourbizupgraded.com.
        </p>
      </section>
    </LegalContent>
  </main>
  <Footer lang={lang} />
</BaseLayout>
