---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPulsoProspect } from "../../lib/pulso/prospects";
import { pulsoProspects11to15 } from "../../lib/pulso/prospects-11-15";
import { pulsoProspect14Override } from "../../lib/pulso/prospect-14-override";

export const prerender = false;

const value = Astro.params.slug ?? "";
const prospect =
  (pulsoProspect14Override.slug === value || pulsoProspect14Override.id === value
    ? pulsoProspect14Override
    : undefined) ??
  getPulsoProspect(value) ??
  pulsoProspects11to15.find((p) => p.slug === value || p.id === value);

if (!prospect) {
  return Astro.redirect("/404", 302);
}

const whatsappMessage = `Hola Gerardo, vi la revisión que preparaste para ${prospect.name} y quiero hablar contigo.`;
const whatsappUrl = `https://wa.me/14074049495?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout
  title={`${prospect.name} | Revisión preparada para ti`}
  description={`Revisión pública preparada para ${prospect.name}.`}
  noindex={true}
  chatbot={false}
>
  <main class="min-h-screen bg-[#f6f7f2] text-[#10263d]">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:px-8 sm:py-20">
      <header class="border-b border-[#10263d]/15 pb-10">
        <div class="mb-8">
          <img src="/assets/logo-lockup.webp" alt="Automate IT" class="h-auto w-44 sm:w-52" width="1100" height="250" />
        </div>
        <h1 class="max-w-2xl font-heading text-4xl font-extrabold leading-tight sm:text-6xl">{prospect.contactFirstName}, {prospect.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[#33485d]">{prospect.intro}</p>
        <p class="mt-4 text-sm font-semibold text-[#167f91]">Puedes ver todo sin dejar tus datos.</p>
      </header>

      <section class="py-10" aria-labelledby="hecho">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#167f91]">Hecho</p>
        <h2 id="hecho" class="mt-3 font-heading text-3xl font-extrabold">Lo que pude comprobar desde afuera</h2>
        <div class="mt-8 space-y-6">
          {prospect.facts.map((fact, index) => (
            <article class="rounded-2xl border border-[#10263d]/10 bg-white p-6 shadow-sm sm:p-8">
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#167f91]">0{index + 1}</p>
              <h3 class="pulso-card-title mt-3 text-xl tracking-normal sm:text-2xl">{fact.title}</h3>
              <p class="mt-4 leading-7 text-[#425468]">{fact.body}</p>
              {fact.sources && <div class="mt-5 flex flex-col items-start gap-3">{fact.sources.map((source) => <a class="font-semibold text-[#167f91] underline decoration-2 underline-offset-4" href={source.url} target="_blank" rel="noreferrer">{source.label}</a>)}</div>}
            </article>
          ))}
        </div>
      </section>

      <section class="border-t border-[#10263d]/15 py-10" aria-labelledby="desconocido">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#167f91]">Lo que no sabemos</p>
        <h2 id="desconocido" class="mt-3 font-heading text-3xl font-extrabold">Desde afuera solo se ve una parte</h2>
        <p class="mt-5 text-lg leading-8 text-[#425468]">{prospect.unknowns}</p>
      </section>

      <section class="rounded-3xl bg-[#10263d] p-7 text-white sm:p-10" aria-labelledby="revisar">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#73d3df]">Qué revisaríamos</p>
        <h2 id="revisar" class="mt-3 font-heading text-3xl font-extrabold">Medir antes de cambiar</h2>
        <p class="mt-5 text-lg leading-8 text-white/80">{prospect.review}</p>
        <p class="mt-6 leading-7 text-white/80">{prospect.closing}</p>
        <a id="pulso-cta" href={whatsappUrl} class="mt-7 inline-flex min-h-12 items-center justify-center rounded-full bg-[#73d3df] px-6 py-3 font-bold text-[#10263d] transition hover:bg-white focus:outline-none focus:ring-4 focus:ring-[#73d3df]/40">Hablar con Gerardo</a>
        <p class="mt-6 text-sm text-white/65">Gerardo Navas · Automate IT</p>
      </section>
    </div>
  </main>

  <script is:inline define:vars={{ prospectId: prospect.id, prospectSlug: prospect.slug, ctaEvent: prospect.ctaEvent ?? "pulso_cta_whatsapp" }}>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (params.get("qa") === "1") return;
      var fromQr = params.get("source") === "qr";
      var eventParams = { prospect_id: prospectId, company_slug: prospectSlug, campaign: "pulso_print" };
      if (fromQr) window.trackEvent?.("pulso_qr_scan", eventParams);
      window.trackEvent?.("pulso_landing_view", eventParams);
      document.getElementById("pulso-cta")?.addEventListener("click", function () { window.trackEvent?.(ctaEvent, eventParams); });
    })();
  </script>
</BaseLayout>

<style>
  .pulso-card-title { font-family: "Open Sans", system-ui, sans-serif; font-weight: 600; line-height: 1.5; }
</style>
