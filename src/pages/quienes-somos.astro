---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const lang = "es" as const;

// Estos tres datos son el NAP (nombre, dirección, teléfono). Tienen que
// coincidir carácter por carácter con el schema de BaseLayout, con el footer y
// con el perfil de Google Business. Si cambia uno, cambian los cuatro.
const nap = {
  legalName: "Automate IT LLC",
  locality: "Orlando, Florida, Estados Unidos",
  phoneHref: "+14072145114",
  phonePretty: "(407) 214-5114",
  email: "automateit@yourbizupgraded.com",
  sunbizDoc: "L26000247785",
};

const queHacemos = [
  {
    heading: "Mapeamos cómo funciona hoy",
    body: "Vemos cómo entra el trabajo, cómo avanza, quién participa, qué herramientas usa el equipo y dónde aparecen retrasos, errores o pasos que dependen demasiado de una persona.",
  },
  {
    heading: "Priorizamos lo que más pesa",
    body: "Buscamos dónde se pierde tiempo, información o dinero y elegimos primero el punto que tenga suficiente impacto para justificar un cambio.",
  },
  {
    heading: "Construimos la mejora adecuada",
    body: "Podemos simplificar un proceso, quitar pasos, crear un formulario, corregir una parte del website, ordenar datos, conectar herramientas, crear un control o automatizar. La causa decide qué conviene construir.",
  },
  {
    heading: "Medimos si funcionó",
    body: "Antes de cerrar el trabajo definimos qué cambio debería verse en la operación. Después revisamos el resultado y ajustamos lo necesario.",
  },
];
---

<BaseLayout
  lang={lang}
  title="Quiénes somos — Automate IT LLC · Orlando, Florida"
  description="Ayudamos a dueños de pequeños y medianos negocios a encontrar dónde su operación pierde tiempo, información o dinero y a construir una mejora medible."
>
  <Nav lang={lang} />
  <main>
    <section class="bg-[#050A18] text-white py-16 sm:py-24">
      <div class="max-w-3xl mx-auto px-5 lg:px-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs sm:text-sm text-white/55 hover:text-brand-cyan transition-colors mb-10"
        >
          ← Volver al inicio
        </a>

        <header class="mb-12">
          <p
            class="text-[11px] tracking-[0.22em] uppercase text-brand-cyan font-semibold mb-4"
          >
            Quiénes somos
          </p>
          <h1
            class="font-heading text-3xl sm:text-5xl leading-tight mb-5 text-white"
          >
            Entramos en la operación para entender qué la está frenando.
          </h1>
          <p class="text-base sm:text-lg text-white/75 leading-relaxed">
            Somos {nap.legalName}, una compañía registrada en Florida. Trabajamos
            con dueños de pequeños y medianos negocios para entender cómo fluye
            el trabajo, encontrar dónde se traba y mejorar lo que realmente vale
            la pena intervenir.
          </p>
        </header>

        <section class="mb-14">
          <h2 class="font-heading text-2xl sm:text-3xl mb-4 text-white">
            El problema que buscamos
          </h2>
          <p
            class="text-sm sm:text-base text-white/80 leading-relaxed mb-4"
          >
            A medida que un negocio crece, aparecen tareas que alguien tiene que
            recordar, información que se mueve a mano, aprobaciones que esperan
            al dueño, clientes que quedan pendientes y procesos que funcionan
            porque una persona sabe cómo mantenerlos andando.
          </p>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed">
            Revisamos ese flujo para encontrar la causa de la fricción. A veces
            conviene cambiar un proceso. Otras veces hace falta conectar dos
            herramientas, crear un control, ajustar el website o automatizar una
            parte concreta. También puede ser mejor dejar algo como está.
          </p>
        </section>

        <section class="mb-14">
          <h2 class="font-heading text-2xl sm:text-3xl mb-6 text-white">
            Cómo trabajamos
          </h2>
          <div class="space-y-7">
            {
              queHacemos.map((item) => (
                <div>
                  <h3 class="font-heading text-lg sm:text-xl mb-2 text-white">
                    {item.heading}
                  </h3>
                  <p class="text-sm sm:text-base text-white/75 leading-relaxed">
                    {item.body}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <section class="mb-14">
          <h2 class="font-heading text-2xl sm:text-3xl mb-4 text-white">
            Dónde estamos
          </h2>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed">
            Nuestra sede está en Orlando, Florida. Podemos trabajar de forma
            remota con negocios fuera del estado cuando el diagnóstico y el tipo
            de intervención lo permiten. Florida sigue siendo nuestro mercado de
            origen y el lugar donde podemos observar una operación en persona
            cuando hace falta.
          </p>
        </section>

        <section
          class="rounded-xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 mb-12"
        >
          <h2 class="font-heading text-xl sm:text-2xl mb-5 text-white">
            Datos de la empresa
          </h2>
          <dl class="space-y-4 text-sm sm:text-base">
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Razón social</dt>
              <dd class="text-white/90">{nap.legalName}</dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Registro estatal</dt>
              <dd class="text-white/90">
                Florida · Documento {nap.sunbizDoc}
                <span class="block text-xs text-white/45 mt-1">
                  Verificable en el registro público de la División de
                  Corporaciones de Florida (sunbiz.org).
                </span>
              </dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Ubicación</dt>
              <dd class="text-white/90">{nap.locality}</dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Teléfono</dt>
              <dd>
                <a
                  href={`tel:${nap.phoneHref}`}
                  class="text-white/90 hover:text-brand-cyan transition-colors"
                >
                  {nap.phonePretty}
                </a>
              </dd>
            </div>
            <div class="sm:flex sm:gap-4">
              <dt class="text-white/50 sm:w-44 shrink-0">Correo</dt>
              <dd>
                <a
                  href={`mailto:${nap.email}`}
                  class="text-white/90 hover:text-brand-cyan transition-colors break-all"
                >
                  {nap.email}
                </a>
              </dd>
            </div>
          </dl>
        </section>

        <div
          class="rounded-xl border border-brand-cyan/25 bg-brand-cyan/[0.06] p-6 sm:p-8"
        >
          <h2 class="font-heading text-xl sm:text-2xl mb-3 text-white">
            ¿Quieres ver dónde se te está yendo el tiempo?
          </h2>
          <p class="text-sm sm:text-base text-white/75 leading-relaxed mb-6">
            El diagnóstico toma unos cinco minutos. Tus respuestas nos dan el
            punto de partida para preparar La Radiografía de tu Operación y
            decidir qué vale la pena revisar primero.
          </p>
          <a
            href="/diagnostico"
            class="inline-flex items-center justify-center rounded-lg bg-brand-cyan px-6 py-3 font-semibold text-[#050A18] hover:bg-white transition-colors"
          >
            Solicitar diagnóstico gratuito
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
